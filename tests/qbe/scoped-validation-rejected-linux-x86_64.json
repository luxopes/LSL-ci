  "candidate_patch": "diff --git a/compiler/pure/qbe_emit.lsl b/compiler/pure/qbe_emit.lsl\nindex d908f18..d3aa8a2 100644\n--- a/compiler/pure/qbe_emit.lsl\n+++ b/compiler/pure/qbe_emit.lsl\n@@ -2381,6 +2381,9 @@ function call_expression(s,node):\n end\n function emit_function(shared,name,declaration,callback=False):\n     s = Dictionary(shared)\n+    # Validation keys use the lexical scope for main, functions and callbacks.\n+    # An error in an unused helper must not tax every expression in this scope.\n+    s[\"has_validation_errors\"] = name in shared[\"validation_error_scopes\"]\n     s[\"lines\"] = []\n     s[\"needs_gc_poll\"] = False\n     s[\"allocation_calls\"] = 0\n@@ -2550,7 +2553,15 @@ function generate(unit,path,entry_source=\"\"):\n     for scope in unit[\"function_scopes\"].values():\n         guarded_globals.update(scope[\"global_reads\"])\n     end\n-    shared = {\"unit\":unit,\"entry_source\":entry_source,\"ids\":ids,\"strings\":{},\"used\":{},\"queue\":[],\"effects\":{},\"native_helpers\":{},\"callbacks\":{},\"guarded_globals\":guarded_globals,\"has_validation_errors\":len(unit[\"validation_errors\"]) > 0}\n+    validation_error_scopes = {}\n+    for locations in unit[\"validation_errors\"].values():\n+        for key in locations:\n+            # source_key is scope:path:line:column; paths may contain colons,\n+            # whereas lexical scope names cannot. Main has the empty prefix.\n+            validation_error_scopes[key[0:key.find(\":\")]] = True\n+        end\n+    end\n+    shared = {\"unit\":unit,\"entry_source\":entry_source,\"ids\":ids,\"strings\":{},\"used\":{},\"queue\":[],\"effects\":{},\"native_helpers\":{},\"callbacks\":{},\"guarded_globals\":guarded_globals,\"validation_error_scopes\":validation_error_scopes}\n     bodies = [emit_function(shared,\"\",None)]\n     call writefile(path,\"\")\n     cursor = 0\n",
  "reproducer_source": "#!/usr/bin/env python3\n\"\"\"Exact SSA/behavior proof and isolated paired compile benchmark for scope gating.\"\"\"\nimport argparse, hashlib, json, statistics, subprocess, tempfile\nfrom pathlib import Path\nfrom verify_public_int import run, digest\nROOT = Path(__file__).resolve().parents[2]\nparser=argparse.ArgumentParser()\nparser.add_argument('--seed', type=Path, required=True)\nparser.add_argument('--backend', type=Path, required=True)\nparser.add_argument('--common', type=Path, required=True)\nparser.add_argument('--build', type=Path, required=True)\nargs=parser.parse_args(); seed=args.seed.resolve(); backend=args.backend.resolve(); common=args.common.resolve(); b=args.build.resolve();b.mkdir(parents=True,exist_ok=True)\nreport={'scope':'Per-lexical-scope recoverable validation lookup gating','seed_sha256':digest(seed),'backend_sha256':digest(backend),'common_sha256':digest(common),'commands':[],'ssa_checks':[],'benchmarks':[],'all_pass':False}\nout=b/'verification.json'\ndef save():out.write_text(json.dumps(report,indent=2)+'\\n')\ndef check(name,cmd,timeout=120):\n row=run(cmd,timeout=timeout);row['name']=name;report['commands'].append(row);save();print(name,row['returncode'],round(row['seconds'],4),flush=True)\n assert row['returncode']==0 and not row['timed_out'],row\n return row\nemitter=ROOT/'compiler/pure/qbe_emit.lsl';candidate_source=emitter.read_bytes();baseline_source=subprocess.check_output(['git','show','0339509:compiler/pure/qbe_emit.lsl'],cwd=ROOT)\ndriver='''# lsl: internal-abi\nload frontend\nload qbe_emit\nload host\npath = arg(1)\nsource = readfile(path)\ninternal = source.startswith(\"# lsl: internal-abi\" + chr(10))\nif arg(3) == \"public\":\n    internal = False\nelif arg(3) == \"internal\":\n    internal = True\nend\nunit = frontend.prepare(path, source, readfile(host.resource_path(\"compiler/pure/dynamic_stdlib.lsl\")), 0, internal)\ncall qbe_emit.generate(unit, arg(2))\n'''\nwith tempfile.NamedTemporaryFile(mode='w',suffix='.lsl',prefix='.scoped-validation-',dir=ROOT/'compiler/pure',delete=False) as temp:\n temp.write(driver);driver_path=Path(temp.name)\ntry:\n emitter.write_bytes(baseline_source)\n check('compile baseline diagnostic emitter',[seed,'--unsafe',driver_path,b/'baseline-dump',backend])\nfinally:\n emitter.write_bytes(candidate_source)\ntry:\n check('compile candidate diagnostic emitter',[seed,'--unsafe',driver_path,b/'candidate-dump',backend])\n check('compile candidate frontend',[seed,'--unsafe','compiler/pure/lslc_qbe.lsl',b/'candidate',backend])\nfinally:\n driver_path.unlink(missing_ok=True)\nfixtures=['tests/compiler/scalar_smoke.lsl','tests/safe_recovery_conformance.lsl','tests/runtime_error_conformance.lsl','tests/class_method_return_conformance.lsl','tests/dynamic_method_boundary_conformance.lsl','tests/qbe/scoped_validation_errors.lsl']\nfor index,source in enumerate(fixtures+[str(common)]):\n for mode in ['public','internal']:\n  paths=[]\n  for name in ['baseline','candidate']:\n   output=b/(str(index)+'-'+mode+'-'+name+'.ssa')\n   check('SSA '+name+' '+mode+' '+source,[b/(name+'-dump'),source,output,mode])\n   paths.append(output)\n  row={'source':source,'mode':mode,'baseline_sha256':digest(paths[0]),'candidate_sha256':digest(paths[1]),'identical':paths[0].read_bytes()==paths[1].read_bytes()};report['ssa_checks'].append(row);save();assert row['identical'],row\nfor compiler_name,compiler in [('baseline',seed),('candidate',b/'candidate')]:\n for source in fixtures:\n  output=b/(Path(source).stem+'-'+compiler_name)\n  check('production '+compiler_name+' '+source,[compiler,'--unsafe',source,output,backend])\n  row=check('execute '+compiler_name+' '+source,[output])\n  expected=ROOT/source.replace('.lsl','.out')\n  if expected.exists():assert row['stdout']==expected.read_text(),row\nfor pair in range(3):\n for name,compiler in ([('baseline',seed),('candidate',b/'candidate')] if pair%2==0 else [('candidate',b/'candidate'),('baseline',seed)]):\n  output=b/('common-'+name+'-'+str(pair))\n  row=check('paired compile '+name+' '+str(pair),[compiler,'--unsafe',common,output,backend]);report['benchmarks'].append({'pair':pair,'variant':name,'seconds':row['seconds'],'output_sha256':digest(output)});save()\n assert report['benchmarks'][-1]['output_sha256']==report['benchmarks'][-2]['output_sha256']\n base=statistics.median([x['seconds'] for x in report['benchmarks'] if x['variant']=='baseline']);cand=statistics.median([x['seconds'] for x in report['benchmarks'] if x['variant']=='candidate'])\n if pair==1 and (base-cand)/base<=0.01:break\nreport['baseline_median_seconds']=base;report['candidate_median_seconds']=cand;report['speedup_fraction']=(base-cand)/base;report['source_sha256']=digest(emitter);report['candidate_sha256']=digest(b/'candidate');report['runtime_sha256']=digest(ROOT/'build/qbe/runtime.o');report['all_pass']=True;save();print(json.dumps({k:report[k] for k in ['all_pass','baseline_median_seconds','candidate_median_seconds','speedup_fraction']}),flush=True)\n",
  "measurement_note": "Exclusive CPU window; two alternating baseline/candidate pairs. Third pair required only if initial improvement exceeds1%; candidate instead regressed0.60%."
