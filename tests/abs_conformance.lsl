print abs(-3.5), abs(3.5), abs(-5), abs(5)
print abs(0.0), abs(-0.0), abs(0)
x = -2.5
print abs(x)
y = -7
print abs(y)
reals = ![-1.0, 2.0, -3.0]
print abs(reals[0]), abs(reals[1]), abs(reals[2])
ints = [-7, 3, -9]
print abs(ints[0]), abs(ints[2])
print abs(-1.5) + abs(2.5)
print String(abs(-4.5))
print abs(-1000000000000)
