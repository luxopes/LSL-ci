a = [1, 2, 3, 4, 5, 6, 7, 8]
print a[::]
print a[::2]
print a[1:6:2]
print a[::-1]
print a[6:1:-1]
print a[::-2]
print a[2::2]
print a[:5:2]
s = "abcdefgh"
print s[::2]
print s[::-1]
print s[1:6:2]
print s[::-2]
t = (1, 2, 3, 4, 5)
print t[::2]
print t[::-1]
r = ![1.0, 2.0, 3.0, 4.0]
print r[::2]
print r[::-1]
print a[2:2:1]
print a[100:200:1]
print a[10:20]
print [1, 2, 3][2:20]
print a[5:2]
print s[1:20]
print s[5:2]
print [1, 2, 3][-10:2]
print s[-10:3]
