# Konstanty Linuxu ARM (armv7, EABI, hard-float), 32 bitů. Systémová
# volání podle tabulky ARM EABI; čas jen přes *_time64 (64bitový timespec
# jako na 64bitových cílech), SYS_MMAP je mmap2 (posun v 4KiB stránkách),
# SYS_NEWFSTATAT je fstatat64, SYS_NANOSLEEP clock_nanosleep_time64.
# Struktury s ukazateli (iovec, msghdr, cmsghdr, sigaction) mají 32bitová
# pole, WORD_BYTES = 4.


NAME = "linux-arm"
RUNTIME = "lsl-runtime-linux-arm-v1"

