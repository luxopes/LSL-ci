ELF_MACHINE = 40

# 32bitové rozdíly volání (os_linux.lsl): mmap2 má posun ve stránkách,
# pread64 bere 64bitový posun v páru registrů r4:r5 (EABI zarovná pár),
# nanosleep jde přes clock_nanosleep_time64 (hodiny, příznaky, požadavek,
# zbytek).
MMAP_OFFSET_SHIFT = 12
PREAD64_PAIR = 1
NANOSLEEP_CLOCK = 1
# Značka adres haldy (os_linux.lsl): 32bitové cíle 2^40, jinak 0.
HEAP_ADDRESS_TAG = 1099511627776
# Původní SO_RCVTIMEO/SO_SNDTIMEO (timeval se slovy cíle): záloha na 32bitových
# cílech pro jádra a emulátory bez *_NEW (64bitový čas).
SO_RCVTIMEO_OLD = 20
SO_SNDTIMEO_OLD = 21
