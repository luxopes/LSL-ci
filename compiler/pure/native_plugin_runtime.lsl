# Restricted self-contained ELF ET_DYN loader for the public CPU native ABI.
# No relocations or external symbols: mapped file offsets must equal st_value.

load assembler
load bytes
load x86_64

function emit_open(output):
    call assembler.label(output, "runtime_native_open")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_open_fail")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 64))
    call assembler.relative(output, [15, 140], "native_open_close_fail")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 5))
    call assembler.emit(output, x86_64.mov_imm64(10, 2))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.mov_imm64(0, 9))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "native_open_fail")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 1179403647))
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(9, 4294967295))
    call assembler.emit(output, x86_64.and_reg_reg(8, 9))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 2))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.load_memory(1, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(9, 65535))
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.and_reg_reg(8, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 3))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(1, 16))
    call assembler.emit(output, x86_64.and_reg_reg(1, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 62))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 11))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_open_unmap_fail")
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, 11))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [233], "native_open_fail")
    call assembler.label(output, "native_open_close_fail")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "native_open_fail")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_access(output):
    call assembler.label(output, "runtime_native_size")
    call assembler.emit(output, x86_64.load_memory(0, 7, 16))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_native_u64")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.load_indexed(0, 7, 6, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_native_name_equal")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 6, 0))
    call assembler.emit(output, x86_64.load_memory(1, 2, 8))
    call assembler.emit(output, x86_64.lea_base(2, 2, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.label(output, "native_name_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 141], "native_name_end")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 7, 8))
    call assembler.emit(output, x86_64.load_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 6))
    call assembler.relative(output, [15, 133], "native_name_false")
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "native_name_loop")
    call assembler.label(output, "native_name_end")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_name_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "native_name_false")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_native_function")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.add_reg_reg(1, 6))
    call assembler.emit(output, x86_64.store_stack(-8, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 12))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_call_close(output):
    call assembler.label(output, "runtime_native_call")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.load_memory(8, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "native_call_closed")
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "native_call_closed")
    call assembler.emit(output, x86_64.load_memory(11, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 6))
    call assembler.relative(output, [15, 133], "native_call_too_wide")
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    # Slots are tagged Ints. Load payloads in reverse so base pointer may use r10.
    call assembler.emit(output, x86_64.load_memory(9, 10, 40))
    call assembler.emit(output, x86_64.load_memory(9, 9, 8))
    call assembler.emit(output, x86_64.load_memory(8, 10, 32))
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.load_memory(1, 10, 24))
    call assembler.emit(output, x86_64.load_memory(1, 1, 8))
    call assembler.emit(output, x86_64.load_memory(2, 10, 16))
    call assembler.emit(output, x86_64.load_memory(2, 2, 8))
    call assembler.emit(output, x86_64.load_memory(7, 10, 0))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.load_memory(6, 10, 8))
    call assembler.emit(output, x86_64.load_memory(6, 6, 8))
    call assembler.emit(output, x86_64.call_reg(11))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_too_wide")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_closed")
    call assembler.relative(output, x86_64.lea_rip_prefix(13), "native_call_closed_data")
    call assembler.emit(output, x86_64.mov_imm64(14, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_closed_data")
    message = "NativeError: native library is closed"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "runtime_native_close")
    call assembler.emit(output, x86_64.move_reg_reg(8, 7))
    call assembler.emit(output, x86_64.load_memory(6, 7, 16))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, 11))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_memory_imm32(8, 8, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_all(output):
    call emit_open(output)
    call emit_access(output)
    call emit_call_close(output)
end
