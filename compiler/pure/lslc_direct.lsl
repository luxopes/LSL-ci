# Final direct compiler driver: LSL source -> executable ELF in one process.
# No decimal byte specification and no external materializer.

load codegen
load linker
load parser

function dirname(path):
    slash = -1
    index = 0
    while index < len(path):
        if path[index] == "/":
            slash = index
        end
        index += 1
    end
    if slash < 0:
        return "."
    elif slash == 0:
        return "/"
    end
    return path[0:slash]
end

function resource_path(path):
    executable = executable_path()
    binary_directory = dirname(executable)
    root_candidate = binary_directory + "/" + path
    if exists(root_candidate):
        return root_candidate
    end
    root_candidate = dirname(dirname(dirname(executable))) + "/" + path
    if exists(root_candidate):
        return root_candidate
    end
    prefix = dirname(binary_directory)
    prefix_bin = prefix + "/bin"
    if prefix == "/":
        prefix_bin = "/bin"
    end
    # Consult prefix/lib only for a real prefix/bin installation. A compiler
    # copied to /tmp for fixed-point development must not silently consume a
    # stale /lib/lsl tree instead of the current checkout.
    if binary_directory == prefix_bin:
        # Return the trusted location even when it is missing. readfile then
        # fails closed instead of consulting an attacker-controlled cwd.
        return prefix + "/lib/lsl/" + path
    end
    # A compiler installed beside its resources must never be shadowed by a
    # same-named file in an attacker-controlled working directory. This final
    # fallback exists only for development compilers copied outside the tree.
    return path
end

source_path = arg(1)
output_path = arg(2)
if source_path == None or output_path == None:
    print "usage: lslc SOURCE OUTPUT"
    exit(2)
end
source = readfile(source_path)
stdlib_name = "compiler/pure/dynamic_stdlib.lsl"
stdlib_path = resource_path(stdlib_name)
stdlib_source = readfile(stdlib_path)
# The physical resource may live in a repository or an installed prefix. Keep
# its logical source name stable so diagnostics and generated bytes do not
# depend on the compiler executable's location.
program = parser.parse(stdlib_name, stdlib_source)
call linker.annotate_statements(program, stdlib_name)
program.extend(linker.link(source_path, source))
image = codegen.generate(source_path, source, program)
call writebytes(output_path, image)
