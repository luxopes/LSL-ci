# Syscall-only native helper routines emitted directly as x86_64 bytes.

load assembler
load heap_runtime
load io_runtime
load process_runtime
load x86_64

function emit_print_int(output):
    call assembler.label(output, "runtime_print_int")
    call assembler.emit(output, x86_64.function_prologue(48))
    # rsi starts at rbp; digits are produced backwards in the local frame.
    call assembler.emit(output, [72, 141, 181, 0, 0, 0, 0])
    call assembler.emit(output, x86_64.mov_imm64(1, 0))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "positive")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.emit(output, x86_64.mov_imm64(9, 1))
    call assembler.label(output, "positive")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "digits")
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_imm(6, 48))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "sign")
    call assembler.label(output, "digits")
    call assembler.label(output, "digit_loop")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.div_reg(10))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 48))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_reg(6, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.test_reg_reg(0, 0))
    call assembler.relative(output, [15, 133], "digit_loop")
    call assembler.label(output, "sign")
    call assembler.emit(output, x86_64.test_reg_reg(9, 9))
    call assembler.relative(output, [15, 132], "write")
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_imm(6, 45))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.label(output, "write")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_print_string(output):
    call assembler.label(output, "runtime_print_string")
    call assembler.emit(output, x86_64.load_memory(2, 7, 8))
    call assembler.emit(output, x86_64.lea_base(6, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
end

function emit_int_to_string(output):
    call assembler.label(output, "runtime_int_to_string")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, [72, 141, 181, 0, 0, 0, 0])
    call assembler.emit(output, x86_64.mov_imm64(1, 0))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "itos_positive")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.emit(output, x86_64.mov_imm64(9, 1))
    call assembler.label(output, "itos_positive")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "itos_digits")
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_imm(6, 48))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "itos_sign")
    call assembler.label(output, "itos_digits")
    call assembler.label(output, "itos_loop")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.div_reg(10))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 48))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_reg(6, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.test_reg_reg(0, 0))
    call assembler.relative(output, [15, 133], "itos_loop")
    call assembler.label(output, "itos_sign")
    call assembler.emit(output, x86_64.test_reg_reg(9, 9))
    call assembler.relative(output, [15, 132], "itos_allocate")
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.store_byte_imm(6, 45))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.label(output, "itos_allocate")
    call assembler.emit(output, x86_64.store_stack(-56, 6))
    call assembler.emit(output, x86_64.store_stack(-64, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-72, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -64))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.lea_base(7, 0, 16))
    call assembler.emit(output, x86_64.load_stack(6, -56))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "itos_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "itos_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 6, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(7, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "itos_copy")
    call assembler.label(output, "itos_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(7, 1, 8))
    call assembler.emit(output, x86_64.load_stack(0, -72))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_to_int(output):
    call assembler.label(output, "runtime_string_to_int")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.lea_base(6, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "stoi_done")
    call assembler.emit(output, x86_64.load_byte_zero_extend(2, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 45))
    call assembler.relative(output, [15, 133], "stoi_loop")
    call assembler.emit(output, x86_64.mov_imm64(9, 1))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.label(output, "stoi_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 141], "stoi_sign")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 6, 8))
    call assembler.emit(output, x86_64.add_reg_imm8(2, -48))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 10))
    call assembler.emit(output, x86_64.add_reg_reg(0, 2))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "stoi_loop")
    call assembler.label(output, "stoi_sign")
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "stoi_done")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.label(output, "stoi_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_chr_ord(output):
    call assembler.label(output, "runtime_chr")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 21))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 128))
    call assembler.relative(output, [15, 130], "chr_one")
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 2048))
    call assembler.relative(output, [15, 130], "chr_two")
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 65536))
    call assembler.relative(output, [15, 130], "chr_three")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 18))
    call assembler.emit(output, x86_64.mov_imm64(8, 240))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 16, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 12))
    call assembler.emit(output, x86_64.and_reg_imm8(2, 63))
    call assembler.emit(output, x86_64.mov_imm64(8, 128))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 17, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 6))
    call assembler.emit(output, x86_64.and_reg_imm8(2, 63))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 18, 2))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.or_reg_reg(1, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 19, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 4))
    call assembler.relative(output, [233], "chr_done")
    call assembler.label(output, "chr_three")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 12))
    call assembler.emit(output, x86_64.mov_imm64(8, 224))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 16, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 6))
    call assembler.emit(output, x86_64.and_reg_imm8(2, 63))
    call assembler.emit(output, x86_64.mov_imm64(8, 128))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 17, 2))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.or_reg_reg(1, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 18, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.relative(output, [233], "chr_done")
    call assembler.label(output, "chr_two")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(2, 6))
    call assembler.emit(output, x86_64.mov_imm64(8, 192))
    call assembler.emit(output, x86_64.or_reg_reg(2, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 16, 2))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.mov_imm64(8, 128))
    call assembler.emit(output, x86_64.or_reg_reg(1, 8))
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 17, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.relative(output, [233], "chr_done")
    call assembler.label(output, "chr_one")
    call assembler.emit(output, x86_64.store_byte_reg_disp(0, 16, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.label(output, "chr_done")
    call assembler.emit(output, x86_64.store_memory(0, 8, 2))
    call assembler.emit(output, x86_64.lea_base(8, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 2, 1))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_ord")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "ord_done")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "ord_two")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "ord_three")
    call assembler.emit(output, x86_64.and_reg_imm8(0, 7))
    call assembler.emit(output, x86_64.shift_left_imm(0, 18))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 17))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.shift_left_imm(1, 12))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 18))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.shift_left_imm(1, 6))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 19))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "ord_three")
    call assembler.emit(output, x86_64.and_reg_imm8(0, 15))
    call assembler.emit(output, x86_64.shift_left_imm(0, 12))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 17))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.shift_left_imm(1, 6))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 18))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "ord_two")
    call assembler.emit(output, x86_64.and_reg_imm8(0, 31))
    call assembler.emit(output, x86_64.shift_left_imm(0, 6))
    call assembler.emit(output, x86_64.load_byte_zero_extend(1, 7, 17))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 63))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.label(output, "ord_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_print_float(output):
    call assembler.label(output, "runtime_print_fraction6")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.lea_base(6, 5, -1))
    call assembler.emit(output, x86_64.mov_imm64(1, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.label(output, "float_fraction_loop")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.div_reg(10))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 48))
    call assembler.emit(output, x86_64.store_byte_reg(6, 2))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "float_fraction_loop")
    call assembler.emit(output, x86_64.increment(6))
    call assembler.emit(output, x86_64.mov_imm64(2, 6))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_print_float")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    # IEEE-754 NaN / Infinity detection before the finite path.
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.emit(output, x86_64.mov_imm64(1, 9223372036854775807))
    call assembler.emit(output, x86_64.and_reg_reg(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 9218868437227405312))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 130], "print_float_finite")
    call assembler.relative(output, [15, 135], "print_float_nan")
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 136], "print_float_neginf")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_float_inf_text")
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "print_float_neginf")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_float_neginf_text")
    call assembler.emit(output, x86_64.mov_imm64(2, 4))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "print_float_nan")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_float_nan_text")
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "print_float_finite")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "print_float_positive")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_float_minus")
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.mov_imm64(1, -9223372036854775808))
    call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    call assembler.label(output, "print_float_positive")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.double_to_int(0, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.relative(output, [232], "runtime_print_int")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_float_dot")
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.int_to_double(1, 0))
    call assembler.emit(output, x86_64.sub_double(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 4696837146684686336))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.double_to_int(0, 0))
    call assembler.relative(output, [232], "runtime_print_fraction6")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "print_float_minus")
    call assembler.emit(output, [45])
    call assembler.label(output, "print_float_dot")
    call assembler.emit(output, [46])
    call assembler.label(output, "print_float_inf_text")
    call assembler.emit(output, [105, 110, 102])
    call assembler.label(output, "print_float_neginf_text")
    call assembler.emit(output, [45, 105, 110, 102])
    call assembler.label(output, "print_float_nan_text")
    call assembler.emit(output, [110, 97, 110])
end

function emit_float_to_string(output):
    call assembler.label(output, "runtime_fraction_string")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 23))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 6))
    call assembler.emit(output, x86_64.lea_base(6, 0, 21))
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.mov_imm64(1, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.label(output, "fraction_string_loop")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.div_reg(10))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 48))
    call assembler.emit(output, x86_64.store_byte_reg(6, 2))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "fraction_string_loop")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_reg_disp(6, 6, 1))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_float_to_string")
    call assembler.emit(output, x86_64.function_prologue(96))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    # IEEE-754 NaN / Infinity return interned static Strings.
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.emit(output, x86_64.mov_imm64(1, 9223372036854775807))
    call assembler.emit(output, x86_64.and_reg_reg(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 9218868437227405312))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 130], "ftos_finite")
    call assembler.relative(output, [15, 135], "ftos_nan")
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 136], "ftos_neginf")
    call assembler.relative(output, x86_64.lea_rip_prefix(7), "ftos_inf_data")
    call assembler.relative(output, [232], "runtime_string_clone")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "ftos_neginf")
    call assembler.relative(output, x86_64.lea_rip_prefix(7), "ftos_neginf_data")
    call assembler.relative(output, [232], "runtime_string_clone")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "ftos_nan")
    call assembler.relative(output, x86_64.lea_rip_prefix(7), "ftos_nan_data")
    call assembler.relative(output, [232], "runtime_string_clone")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "ftos_finite")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "ftos_positive")
    call assembler.emit(output, x86_64.mov_imm64(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, -9223372036854775808))
    call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    call assembler.label(output, "ftos_positive")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.double_to_int(7, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 7))
    call assembler.relative(output, [232], "runtime_int_to_string")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "ftos_dot")
    call assembler.emit(output, x86_64.mov_imm64(7, 45))
    call assembler.relative(output, [232], "runtime_chr")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], "runtime_string_concat")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.label(output, "ftos_dot")
    call assembler.emit(output, x86_64.mov_imm64(7, 46))
    call assembler.relative(output, [232], "runtime_chr")
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.relative(output, [232], "runtime_string_concat")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.int_to_double(1, 0))
    call assembler.emit(output, x86_64.sub_double(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 4696837146684686336))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.double_to_int(7, 0))
    call assembler.relative(output, [232], "runtime_fraction_string")
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.relative(output, [232], "runtime_string_concat")
    call assembler.emit(output, x86_64.function_epilogue())
    # Static String layouts [type=1:u64, len:u64, payload, null] for clone.
    call assembler.label(output, "ftos_inf_data")
    call assembler.emit(output, [1, 0, 0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 0, 0, 0, 0, 105, 110, 102, 0])
    call assembler.label(output, "ftos_neginf_data")
    call assembler.emit(output, [1, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 0, 0, 0, 0, 45, 105, 110, 102, 0])
    call assembler.label(output, "ftos_nan_data")
    call assembler.emit(output, [1, 0, 0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 0, 0, 0, 0, 110, 97, 110, 0])
end

function emit_clock(output):
    call assembler.label(output, "runtime_clock")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.lea_base(6, 5, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, 228))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.int_to_double(0, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.int_to_double(1, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 4741671816366391296))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 0))
    call assembler.emit(output, x86_64.div_double(1, 2))
    call assembler.emit(output, x86_64.add_double(0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_print_scalar_names(output):
    call assembler.label(output, "runtime_print_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_true_data")
    call assembler.emit(output, x86_64.mov_imm64(2, 4))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "print_true_data")
    call assembler.emit(output, [84, 114, 117, 101])
    call assembler.label(output, "runtime_print_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_false_data")
    call assembler.emit(output, x86_64.mov_imm64(2, 5))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "print_false_data")
    call assembler.emit(output, [70, 97, 108, 115, 101])
    call assembler.label(output, "runtime_print_none")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "print_none_data")
    call assembler.emit(output, x86_64.mov_imm64(2, 4))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "print_none_data")
    call assembler.emit(output, [78, 111, 110, 101])
end

function emit_print_any(output):
    call assembler.label(output, "runtime_print_any")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "print_any_int_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.load_memory(1, 0, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 132], "print_any_bool")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 5))
    call assembler.relative(output, [15, 132], "runtime_print_none")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 132], "print_any_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "print_any_int")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_print_string")
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "print_any_float")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [233], "runtime_print_float")
    call assembler.label(output, "print_any_bool")
    call assembler.emit(output, x86_64.load_memory(1, 0, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "runtime_print_false")
    call assembler.relative(output, [233], "runtime_print_true")
    call assembler.label(output, "print_any_int_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.label(output, "print_any_int")
    call assembler.relative(output, [232], "runtime_print_int")
    call assembler.emit(output, x86_64.ret())
end

function emit_all(output):
    call heap_runtime.emit_all(output)
    call io_runtime.emit_all(output)
    call process_runtime.emit_all(output)
    call emit_print_int(output)
    call emit_print_string(output)
    call emit_int_to_string(output)
    call emit_string_to_int(output)
    call emit_chr_ord(output)
    call emit_print_float(output)
    call emit_float_to_string(output)
    call emit_clock(output)
    call emit_print_scalar_names(output)
    call emit_print_any(output)
end

function print_int():
    output = assembler.builder()
    call emit_print_int(output)
    return assembler.finish(output)
end
