    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "list_zero_loop")
    call assembler.label(output, "list_copy_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "list_new_done")
