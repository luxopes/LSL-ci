    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 133], "dynamic_append_byte_type_error")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(6, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "dynamic_append_byte_range_error")
    call assembler.emit(output, x86_64.cmp_reg_imm32(6, 255))
    call assembler.relative(output, [15, 143], "dynamic_append_byte_range_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_byte_array_append")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dynamic_append_type_error", "dynamic_append_type_error_data", "TypeError: object does not support append")
    call emit_pending_error_return(output, "dynamic_append_int_type_error", "dynamic_append_int_type_error_data", "TypeError: IntArray accepts only Int values")
    call emit_pending_error_return(output, "dynamic_append_float_type_error", "dynamic_append_float_type_error_data", "TypeError: FloatArray accepts only Float values")
    call emit_pending_error_return(output, "dynamic_append_byte_type_error", "dynamic_append_byte_type_error_data", "TypeError: ByteArray accepts only Int values")
    call emit_pending_error_return(output, "dynamic_append_byte_range_error", "dynamic_append_byte_range_error_data", "ValueError: ByteArray value is outside 0..255")

    call assembler.label(output, "runtime_dynamic_clear")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 132], "dynamic_clear_dict")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 132], "dynamic_clear_sequence")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "dynamic_clear_sequence")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "dynamic_clear_sequence")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "dynamic_clear_type_error")
    call assembler.label(output, "dynamic_clear_sequence")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.store_memory_imm32(7, 8, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_clear_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.store_memory_imm32(7, 8, 0))
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dynamic_clear_type_error", "dynamic_clear_type_error_data", "TypeError: object does not support clear")

    call assembler.label(output, "runtime_dynamic_dict_keys")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 133], "dynamic_keys_type_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_dict_keys")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dynamic_keys_type_error", "dynamic_keys_type_error_data", "TypeError: keys requires a Dictionary")
end

function emit_string_byte_offset(output):
    call assembler.label(output, "runtime_string_byte_offset")
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "string_offset_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 6))
    call assembler.relative(output, [15, 141], "string_offset_done")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 8, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "string_offset_one")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "string_offset_two")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "string_offset_three")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 4))
    call assembler.relative(output, [233], "string_offset_next")
    call assembler.label(output, "string_offset_three")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 3))
    call assembler.relative(output, [233], "string_offset_next")
    call assembler.label(output, "string_offset_two")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 2))
    call assembler.relative(output, [233], "string_offset_next")
    call assembler.label(output, "string_offset_one")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.label(output, "string_offset_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "string_offset_loop")
    call assembler.label(output, "string_offset_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.ret())
end

function emit_slice(output):
    call assembler.label(output, "runtime_slice")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "slice_list")

    call assembler.relative(output, [232], "runtime_length")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "slice_string_start_ready")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.label(output, "slice_string_start_ready")
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 141], "slice_string_stop_ready")
    call assembler.emit(output, x86_64.add_reg_reg(2, 0))
    call assembler.label(output, "slice_string_stop_ready")
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    # Clamp start/stop to [0, len] so out-of-range indices give a bounded
    # slice instead of reading past the String (was garbage/overread).
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], "runtime_slice_clamp")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], "runtime_slice_clamp")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_string_byte_offset")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.relative(output, [232], "runtime_string_byte_offset")
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "slice_string_size_ok")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "slice_string_size_ok")
    call assembler.emit(output, x86_64.store_stack(-48, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(6, -40))
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 6, 0))
    call assembler.emit(output, x86_64.load_stack(10, -56))
    call assembler.emit(output, x86_64.lea_base(10, 10, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.label(output, "slice_string_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "slice_string_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "slice_string_copy")
    call assembler.label(output, "slice_string_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 1, 8))
    call assembler.emit(output, x86_64.load_stack(0, -56))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "slice_list")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "slice_list_start_ready")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.label(output, "slice_list_start_ready")
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 141], "slice_list_stop_ready")
    call assembler.emit(output, x86_64.add_reg_reg(2, 0))
    call assembler.label(output, "slice_list_stop_ready")
    # reg2 = stop, reg0 = len. Clamp start/stop to [0, len], floor count at 0.
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.load_stack(6, -40))
    call assembler.relative(output, [232], "runtime_slice_clamp")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.load_stack(6, -40))
    call assembler.relative(output, [232], "runtime_slice_clamp")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "slice_list_size_ok")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "slice_list_size_ok")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(6, 7, 24))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.lea_indexed(6, 6, 1, 3))
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_list_new")
    # value in reg7, len in reg6 -> reg0 = min(max(value,0), len). Leaf.
    call assembler.label(output, "runtime_slice_clamp")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "slice_clamp_lo_ok")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "slice_clamp_lo_ok")
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 6))
    call assembler.relative(output, [15, 142], "slice_clamp_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 6))
    call assembler.label(output, "slice_clamp_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_string_equal(output):
    call assembler.label(output, "runtime_string_equal")
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 6))
    call assembler.relative(output, [15, 132], "string_equal_true")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_memory(2, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 133], "string_equal_false")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "string_equal_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "string_equal_true")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.load_byte_indexed(9, 6, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 133], "string_equal_false")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "string_equal_loop")
    call assembler.label(output, "string_equal_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "string_equal_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
end

function emit_string_contains(output):
    call assembler.label(output, "runtime_string_contains")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "string_contains_true")
    call assembler.emit(output, x86_64.sub_reg_reg(8, 9))
    call assembler.emit(output, x86_64.lea_base(11, 7, 16))
    call assembler.emit(output, x86_64.lea_base(1, 6, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "string_contains_outer")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 143], "string_contains_false")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "string_contains_inner")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "string_contains_true")
    call assembler.emit(output, x86_64.move_reg_reg(7, 10))
    call assembler.emit(output, x86_64.add_reg_reg(7, 2))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 7))
    call assembler.emit(output, x86_64.load_byte_indexed(6, 1, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 6))
    call assembler.relative(output, [15, 133], "string_contains_next")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "string_contains_inner")
    call assembler.label(output, "string_contains_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "string_contains_outer")
    call assembler.label(output, "string_contains_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "string_contains_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
end

function emit_equal_any(output):
    call assembler.label(output, "runtime_equal_any")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 6))
    call assembler.relative(output, [15, 132], "equal_any_true")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "equal_any_left_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "equal_any_left_object_raw")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.load_memory(2, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 133], "equal_any_false")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "equal_any_strings")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 132], "equal_any_payload")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 132], "equal_any_payload")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 132], "equal_any_payload")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 10))
    call assembler.relative(output, [15, 132], "equal_any_payload")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 5))
    call assembler.relative(output, [15, 132], "equal_any_true")
    call assembler.relative(output, [233], "equal_any_false")
    call assembler.label(output, "equal_any_strings")
    call assembler.relative(output, [232], "runtime_string_equal")
    call assembler.relative(output, [233], "equal_any_done")
    call assembler.label(output, "equal_any_payload")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_memory(2, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 132], "equal_any_true")
    call assembler.relative(output, [233], "equal_any_false")
    call assembler.label(output, "equal_any_left_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "equal_any_false")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.relative(output, [233], "equal_any_object_raw")
    call assembler.label(output, "equal_any_left_object_raw")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.label(output, "equal_any_object_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 132], "equal_any_bool_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 132], "equal_any_bool_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 10))
    call assembler.relative(output, [15, 132], "equal_any_bool_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 5))
    call assembler.relative(output, [15, 133], "equal_any_false")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "equal_any_true")
    call assembler.relative(output, [233], "equal_any_false")
    call assembler.label(output, "equal_any_bool_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 6))
    call assembler.relative(output, [15, 132], "equal_any_true")
    call assembler.label(output, "equal_any_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.relative(output, [233], "equal_any_done")
    call assembler.label(output, "equal_any_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.label(output, "equal_any_done")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_is_float(output):
    # reg7 = value -> reg0 = 1 if boxed Float (type 6), else 0.
    call assembler.label(output, "runtime_is_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "is_float_no")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "is_float_no")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "is_float_no")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_coerce_float(output):
    # reg7 = value -> reg0 = boxed Float. Raw Int plus boxed Int/Bool are
    # promoted; an existing boxed Float is returned as-is. Public call sites
    # validate the tag before entering this low-level conversion helper.
    call assembler.label(output, "runtime_coerce_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "coerce_from_int")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 132], "coerce_boxed_integer")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 133], "coerce_existing_float")
    call assembler.label(output, "coerce_boxed_integer")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.label(output, "coerce_from_int")
    call assembler.relative(output, [233], "runtime_float_from_int")
    call assembler.label(output, "coerce_existing_float")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
end

function emit_numeric_value_guard(output):
    call assembler.label(output, "runtime_require_numeric_value")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 133], "numeric_value_maybe_zero")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.relative(output, [233], "numeric_value_type_error")
    call assembler.label(output, "numeric_value_maybe_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_value_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_value_type_error")
    call assembler.label(output, "numeric_value_valid")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "numeric_value_type_error", "numeric_value_type_error_data", "TypeError: numeric operand required")
end

function emit_checked_index(output):
    # Public Any index -> raw signed Int. Bool follows the language's 0/1 index
    # convention; every other heap tag is rejected before bounds arithmetic.
    call assembler.label(output, "runtime_checked_index")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "checked_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "checked_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "checked_index_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "checked_index_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "checked_index_done")
    call assembler.relative(output, [233], "checked_index_type_error")
    call assembler.label(output, "checked_index_unbox")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.relative(output, [233], "checked_index_done")
    call assembler.label(output, "checked_index_raw")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.label(output, "checked_index_done")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "checked_index_type_error", "checked_index_type_error_data", "TypeError: sequence index must be Int")
end

function emit_numeric_pair_guard(output):
    call assembler.label(output, "runtime_require_numeric_pair")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-40, 0))

    # Mode 1 permits exactly String + String. Every mixed String/numeric pair
    # falls through to the numeric checks and is rejected.
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 1))
    call assembler.relative(output, [15, 133], "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.relative(output, [233], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_check_right")
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 133], "numeric_pair_right_maybe_zero")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 2))
    call assembler.relative(output, [15, 133], "numeric_pair_valid")
    call assembler.relative(output, [233], "numeric_pair_type_error")
    call assembler.label(output, "numeric_pair_right_maybe_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_valid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "numeric_pair_type_error", "numeric_pair_type_error_data", "TypeError: numeric operands required")
end

function emit_abs_any(output):
    # reg7 = value -> reg0 = abs. Boxed Float clears the sign bit and reboxes;
    # raw Int negates when negative.
    call assembler.label(output, "runtime_abs_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "abs_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 9223372036854775807))
    call assembler.emit(output, x86_64.and_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "abs_any_int")
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "abs_any_done")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.label(output, "abs_any_done")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_compare_any(output):
    # reg7=left, reg6=right -> reg0 = -1/0/1 (left <=> right). If either is a
    # boxed Float, both are coerced to double and compared; else signed Int.
    call assembler.label(output, "runtime_compare_any")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(0, 0, 8))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(1, 0, 8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.compare_double(0, 1))
    call assembler.relative(output, [15, 130], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_less")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 140], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_neg_any(output):
    # reg7 = value -> reg0 = negation. Boxed Float flips its sign bit and
    # reboxes; raw Int negates.
    call assembler.label(output, "runtime_neg_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "neg_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, -9223372036854775808))
    call assembler.emit(output, x86_64.add_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "neg_any_int")
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_pow_any(output):
    # reg7=base, reg6=Int exponent -> reg0. Boxed Float base uses float_power;
    # raw Int base uses int_power. Dynamic Int bases enforce the same negative
    # exponent error as statically typed Int expressions.
    call assembler.label(output, "runtime_pow_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "pow_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_float_power")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "pow_any_negative_int")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_int_power")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_negative_int")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "pow_any_negative_error_data")
    call assembler.emit(output, x86_64.store_fs(0, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(8, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_negative_error_data")
    message = "ValueError: negative Int exponent"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_num_any(output, name, float_routine, is_add):
    # reg7,reg6 = operands. If either is a boxed Float, promote both to Float
    # and use float_routine (fixes mixed raw-Int + boxed-Float). Otherwise
    # raw Int op, or (add only) String concat when both are Strings.
    scalar_label = name + "_scalar"
    int_label = name + "_int"
    call assembler.label(output, name)
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], scalar_label)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], float_routine)
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, scalar_label)
    if is_add:
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.emit(output, x86_64.load_memory(1, 7, 0))
        call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -16))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -16))
        call assembler.emit(output, x86_64.load_memory(1, 7, 0))
        call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.emit(output, x86_64.load_stack(6, -16))
        call assembler.relative(output, [232], "runtime_string_concat")
        call assembler.emit(output, x86_64.function_epilogue())
    end
    call assembler.label(output, int_label)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    if name == "runtime_add_any":
        call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    elif name == "runtime_sub_any":
        call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    else:
        call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    end
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dynamic_raw_wrapper(output, name):
    call assembler.label(output, name + "_raw")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], name)
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_contains(output):
    call assembler.label(output, "runtime_contains")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "contains_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 3))
    call assembler.relative(output, [15, 132], "contains_dict")
    call assembler.emit(output, x86_64.load_memory(8, 7, 24))
    call assembler.relative(output, [233], "contains_ready")
    call assembler.label(output, "contains_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_string_contains")
    call assembler.label(output, "contains_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "contains_false")
    call assembler.relative(output, [233], "contains_true")
    call assembler.label(output, "contains_ready")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.label(output, "contains_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "contains_false")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "contains_true")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.relative(output, [233], "contains_loop")
    call assembler.label(output, "contains_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "contains_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Dictionary hash index: parallel keys@24/values@32 arrays stay in insertion
# order; index@40 is an open-addressed table of pos+1 slots (0 = empty),
# index_cap@48 slots (power of two, always >= 2*capacity). Hashes are seeded
# from the ASLR-randomized initial process stack so remote inputs cannot
# precompute a collision set and turn Dictionary/JSON insertion into quadratic
# work.
function emit_dict_hash(output):
    call assembler.label(output, "runtime_string_hash")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.load_memory(0, 3, 120))
    call assembler.emit(output, x86_64.mov_imm64(10, 1099511628211))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "string_hash_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 1))
    call assembler.relative(output, [15, 141], "string_hash_done")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 8, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 2))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 10))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "string_hash_loop")
    call assembler.label(output, "string_hash_done")
    call assembler.relative(output, [233], "runtime_hash_mix")
    # SplitMix64 finalizer. Besides distributing low Int bits over the
    # power-of-two table it prevents a chosen scalar collision set without the
    # per-process state address used as the key below.
    call assembler.label(output, "runtime_hash_mix")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 30))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, -4658895280553007687))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 27))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, -7723592293110705685))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 31))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.ret())
    # Hashable dict key -> hash consistent with runtime_equal_any. Raw scalars
    # (Int/Bool/None/Function) and boxed scalar payloads are mixed with the
    # per-process seed; String bytes use seeded FNV-1a before the same mixer.
    call assembler.label(output, "runtime_key_hash")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "key_hash_heap")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.relative(output, [233], "runtime_hash_mix")
    call assembler.label(output, "key_hash_heap")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "runtime_string_hash")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.relative(output, [233], "runtime_hash_mix")
end

function emit_dict_probe(output):
    # reg7=dict, reg6=key(String). Returns reg0=slot, reg1=index[slot] (0 if absent).
    call assembler.label(output, "runtime_dict_probe")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_probe_linear")
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_key_hash")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.label(output, "dict_probe_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_probe_empty")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_found")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_probe_loop")
    call assembler.label(output, "dict_probe_found")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_empty")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    # No index yet (small dict): linear scan of insertion-order keys.
    call assembler.label(output, "dict_probe_linear")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "dict_probe_linear_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_probe_linear_loop")
    call assembler.label(output, "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_index_insert(output):
    # reg7=dict, reg6=key, reg2=pos. Stores pos+1 into the first empty slot.
    call assembler.label(output, "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-40, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_key_hash")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.label(output, "dict_insert_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_insert_store")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_insert_loop")
    call assembler.label(output, "dict_insert_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 2))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_reindex(output):
    # reg7=dict. Zero index_cap slots, then reinsert every key by position.
    call assembler.label(output, "runtime_dict_reindex")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_memory(9, 7, 48))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dict_reindex_zero")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_reindex_zero")
    call assembler.label(output, "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.label(output, "dict_reindex_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_reindex_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(6, 9, 2, 3))
    call assembler.relative(output, [232], "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.relative(output, [233], "dict_reindex_loop")
    call assembler.label(output, "dict_reindex_done")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_new(output):
    call assembler.label(output, "runtime_dict_new")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.mov_imm64(7, 56))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 3))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 16, 16))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 48, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 40, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 128))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 24, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 128))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 32, 0))
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_get(output):
    call assembler.label(output, "runtime_dict_get")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_get_missing")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 32))
    call assembler.emit(output, x86_64.load_indexed(0, 8, 2, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_get_missing")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "dict_get_error_data")
    call assembler.emit(output, x86_64.store_fs(0, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_get_error_data")
    message = "KeyError: key not found"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_dict_keys(output):
    call assembler.label(output, "runtime_dict_keys")
    call assembler.emit(output, x86_64.load_memory(6, 7, 24))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.relative(output, [233], "runtime_list_new")
end

function emit_dict_delete(output):
    call assembler.label(output, "runtime_dict_delete")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
