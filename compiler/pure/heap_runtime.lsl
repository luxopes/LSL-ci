    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "dict_delete_missing")
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_delete_shift_start")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dict_delete_find")
    call assembler.label(output, "dict_delete_shift_start")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.decrement(8))
    call assembler.emit(output, x86_64.store_memory(7, 8, 8))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.label(output, "dict_delete_shift")
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "dict_delete_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_memory(10, 7, 32))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.load_indexed(0, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 0))
    call assembler.emit(output, x86_64.load_indexed(0, 10, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(10, 1, 3, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dict_delete_shift")
    call assembler.label(output, "dict_delete_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_delete_no_index")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.label(output, "dict_delete_no_index")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dict_delete_missing", "dict_delete_error_data", "KeyError: key not found")
end

function emit_dict_grow(output):
    call assembler.label(output, "runtime_dict_grow")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 16))
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_stack(-24, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_memory(11, 7, 32))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.label(output, "dict_grow_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_grow_done")
    call assembler.emit(output, x86_64.load_indexed(0, 10, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 0))
    call assembler.emit(output, x86_64.load_indexed(1, 11, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_grow_copy")
    call assembler.label(output, "dict_grow_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.store_memory(7, 16, 9))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_memory(7, 24, 9))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_memory(7, 32, 9))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_memory(7, 48, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.store_memory(7, 40, 0))
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_set(output):
    call assembler.label(output, "runtime_dict_set")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_set_new")
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.relative(output, [233], "dict_set_store")
    call assembler.label(output, "dict_set_new")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 140], "dict_set_capacity_ready")
    call assembler.relative(output, [232], "runtime_dict_grow")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.label(output, "dict_set_capacity_ready")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 6))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_set_no_index")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.relative(output, [232], "runtime_dict_index_insert")
    call assembler.label(output, "dict_set_no_index")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_memory(7, 8, 1))
    call assembler.label(output, "dict_set_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 32))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_chars(output):
    # String -> List of one-code-point Strings in a single O(n) pass, so the
    # lexer can index a List (O(1)) instead of re-scanning UTF-8 per access.
    # A per-call 128-slot cache interns ASCII chars: source is ~99% ASCII, so
    # this turns ~60k allocations into ~80 and lets equal strings share a
    # pointer (string_equal has a pointer-equality fast path).
    call assembler.label(output, "runtime_string_chars")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 1024))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "chars_cache_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm32(2, 128))
    call assembler.relative(output, [15, 141], "chars_cache_zeroed")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 9))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "chars_cache_zero")
    call assembler.label(output, "chars_cache_zeroed")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.label(output, "chars_loop")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "chars_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 8, 2))
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 4))
    call assembler.label(output, "chars_width_ready")
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.emit(output, x86_64.store_stack(-64, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "chars_alloc")
    call assembler.emit(output, x86_64.load_stack(8, -56))
    call assembler.emit(output, x86_64.load_indexed(9, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "chars_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.relative(output, [233], "chars_append")
    call assembler.label(output, "chars_alloc")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 6, 0))
    call assembler.emit(output, x86_64.load_stack(10, -40))
    call assembler.emit(output, x86_64.lea_base(10, 10, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.label(output, "chars_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "chars_copy_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "chars_copy")
    call assembler.label(output, "chars_copy_done")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 1, 8))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "chars_append")
    call assembler.emit(output, x86_64.load_stack(0, -64))
    call assembler.emit(output, x86_64.load_stack(8, -56))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 9))
    call assembler.label(output, "chars_append")
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.load_stack(6, -40))
    call assembler.relative(output, [232], "runtime_list_append")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.add_reg_reg(2, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [233], "chars_loop")
    call assembler.label(output, "chars_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_array_kernels(output):
    # Contiguous Float64 kernels operate on raw backing bits and allocate only a
    # single boxed result (sum/dot), avoiding per-element language dispatch.
    # Binary CUDA transport helpers preserve all IEEE-754 bits and copy in O(n).
    call assembler.label(output, "runtime_float_array_bytes")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 9))
    call assembler.emit(output, x86_64.move_reg_reg(10, 8))
    call assembler.emit(output, x86_64.shift_left_imm(10, 3))
    call assembler.emit(output, x86_64.store_stack(-24, 10))
    call assembler.emit(output, x86_64.move_reg_reg(7, 10))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 10))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_stack(9, -16))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "float_array_bytes_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "float_array_bytes_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(11, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "float_array_bytes_loop")
    call assembler.label(output, "float_array_bytes_done")
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 10, 1))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_float_array_from_bytes")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.shift_right_logical_imm(8, 3))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.move_reg_reg(7, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 14))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(9, -8))
    call assembler.emit(output, x86_64.lea_base(9, 9, 16))
    call assembler.emit(output, x86_64.load_memory(10, 0, 24))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "float_array_from_bytes_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "float_array_from_bytes_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(10, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "float_array_from_bytes_loop")
    call assembler.label(output, "float_array_from_bytes_done")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())

    # FloatArray kernels use SSE2 two-lane packed doubles with a scalar tail.
    # float_sum/float_dot accumulate even and odd elements in separate lanes
    # and combine them at the end; float_axpy, float_fill and float_matmul
    # perform exactly the same per-element operations as a scalar loop.
    call assembler.label(output, "runtime_float_array_sum")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.unpack_low_packed(0, 0))
    call assembler.label(output, "float_array_sum_loop")
    call assembler.emit(output, x86_64.lea_base(0, 10, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_sum_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(1, 9, 10, 3))
    call assembler.emit(output, x86_64.add_packed(0, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(10, 2))
    call assembler.relative(output, [233], "float_array_sum_loop")
    call assembler.label(output, "float_array_sum_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_array_sum_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 10, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.add_double(0, 1))
    call assembler.label(output, "float_array_sum_done")
    call assembler.emit(output, x86_64.move_packed(1, 0))
    call assembler.emit(output, x86_64.unpack_high_packed(1, 1))
    call assembler.emit(output, x86_64.add_double(0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_float_array_dot")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 0))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    call assembler.label(output, "float_array_dot_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_dot_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 1))
    call assembler.emit(output, x86_64.add_packed(2, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_array_dot_loop")
    call assembler.label(output, "float_array_dot_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 8))
    call assembler.relative(output, [15, 141], "float_array_dot_done")
    call assembler.emit(output, x86_64.load_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.add_double(2, 0))
    call assembler.label(output, "float_array_dot_done")
    call assembler.emit(output, x86_64.move_packed(1, 2))
    call assembler.emit(output, x86_64.unpack_high_packed(1, 1))
    call assembler.emit(output, x86_64.add_double(2, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 2))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())

    # r7=alpha bits, r6=x FloatArray, r2=y FloatArray; mutate y += alpha*x.
    call assembler.label(output, "runtime_float_array_axpy")
    call assembler.emit(output, x86_64.load_memory(8, 6, 8))
    call assembler.emit(output, x86_64.load_memory(9, 6, 24))
    call assembler.emit(output, x86_64.load_memory(10, 2, 24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 7))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.label(output, "float_array_axpy_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_axpy_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 2))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.add_packed(1, 0))
    call assembler.emit(output, x86_64.store_packed_indexed(10, 11, 3, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_array_axpy_loop")
    call assembler.label(output, "float_array_axpy_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 8))
    call assembler.relative(output, [15, 141], "float_array_axpy_done")
    call assembler.emit(output, x86_64.load_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.mul_double(0, 2))
    call assembler.emit(output, x86_64.add_double(1, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 1))
    call assembler.emit(output, x86_64.store_indexed(10, 11, 3, 0))
    call assembler.label(output, "float_array_axpy_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # r7=FloatArray, r6=raw Float64 bits.
    call assembler.label(output, "runtime_float_array_fill")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 6))
    call assembler.emit(output, x86_64.unpack_low_packed(0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "float_array_fill_loop")
    call assembler.emit(output, x86_64.lea_base(0, 10, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_fill_tail")
    call assembler.emit(output, x86_64.store_packed_indexed(9, 10, 3, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(10, 2))
    call assembler.relative(output, [233], "float_array_fill_loop")
    call assembler.label(output, "float_array_fill_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_array_fill_done")
    call assembler.emit(output, x86_64.store_indexed(9, 10, 3, 6))
    call assembler.label(output, "float_array_fill_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # r7=a, r6=b, r2=m, r1=k, r8=n; return C[m,n] = A[m,k] * B[k,n].
    # Loop order i-k-j: each C row accumulates a[i,k] * B[k, j..j+1] with
    # packed doubles, in the same k order as the scalar inner product, so the
    # rounding of every element is identical to the sequential kernel.
    call assembler.label(output, "runtime_float_array_matmul")
    call assembler.emit(output, x86_64.function_prologue(96))
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.load_memory(0, 6, 24))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 8))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.imul_reg_reg(7, 8))
    call assembler.emit(output, x86_64.store_stack(-64, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 14))
    call assembler.emit(output, x86_64.store_stack(-48, 0))
    call assembler.emit(output, x86_64.load_memory(1, 0, 24))
    call assembler.emit(output, x86_64.store_stack(-56, 1))
    # Zero the m*n result before accumulating.
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(9, -64))
    call assembler.emit(output, x86_64.load_stack(7, -56))
    call assembler.label(output, "float_matmul_zero_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "float_matmul_zero_done")
    call assembler.emit(output, x86_64.store_indexed(7, 8, 3, 0))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "float_matmul_zero_loop")
    call assembler.label(output, "float_matmul_zero_done")
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "float_matmul_i_loop")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_matmul_done")
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "float_matmul_k_loop")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "float_matmul_i_next")
    # xmm2 = broadcast a[i, k]
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 8))
    call assembler.emit(output, x86_64.add_reg_reg(0, 9))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_indexed(1, 7, 0, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 1))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    # r8 = &B[k, 0], rcx = &C[i, 0], rdx = n
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 2))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.lea_indexed(8, 7, 0, 3))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 2))
    call assembler.emit(output, x86_64.load_stack(7, -56))
    call assembler.emit(output, x86_64.lea_indexed(1, 7, 0, 3))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.label(output, "float_matmul_j_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 2))
    call assembler.relative(output, [15, 143], "float_matmul_j_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 8, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 2))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 1, 11, 3))
    call assembler.emit(output, x86_64.add_packed(1, 0))
    call assembler.emit(output, x86_64.store_packed_indexed(1, 11, 3, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_matmul_j_loop")
    call assembler.label(output, "float_matmul_j_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 2))
    call assembler.relative(output, [15, 141], "float_matmul_k_next")
    call assembler.emit(output, x86_64.load_indexed(0, 8, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.mul_double(0, 2))
    call assembler.emit(output, x86_64.load_indexed(0, 1, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.add_double(1, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 1))
    call assembler.emit(output, x86_64.store_indexed(1, 11, 3, 0))
    call assembler.label(output, "float_matmul_k_next")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_matmul_k_loop")
    call assembler.label(output, "float_matmul_i_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "float_matmul_i_loop")
    call assembler.label(output, "float_matmul_done")
    call assembler.emit(output, x86_64.load_stack(0, -48))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_all(output):
    call emit_allocator(output)
    call emit_string_chars(output)
    call emit_object_table_growth(output)
    call emit_object_checks(output)
    call emit_parse_literal_int(output)
    call emit_int_power(output)
    call emit_float_power(output)
    call emit_string_concat(output)
    call emit_intern_table_growth(output)
    call emit_string_clone(output)
    call emit_float_runtime(output)
    call emit_float_array_kernels(output)
    call emit_boxed_scalars(output)
    call emit_gc(output)
    call emit_byte_array(output)
    call emit_list_new(output)
    call emit_list_append(output)
    call emit_list_pop_last(output)
    call emit_list_clear(output)
    call emit_set(output)
    call emit_list_set(output)
    call emit_list_get(output)
    call emit_length(output)
    call emit_get(output)
    call emit_dynamic_collections(output)
    call emit_string_byte_offset(output)
    call emit_slice(output)
    call emit_string_equal(output)
    call emit_string_contains(output)
    call emit_equal_any(output)
    call emit_is_float(output)
    call emit_coerce_float(output)
    call emit_numeric_value_guard(output)
    call emit_checked_index(output)
    call emit_numeric_pair_guard(output)
    call emit_abs_any(output)
    call emit_neg_any(output)
    call emit_compare_any(output)
    call emit_pow_any(output)
    call emit_num_any(output, "runtime_add_any", "runtime_float_add", True)
    call emit_num_any(output, "runtime_sub_any", "runtime_float_sub", False)
    call emit_num_any(output, "runtime_mul_any", "runtime_float_mul", False)
    call emit_dynamic_raw_wrapper(output, "runtime_abs_any")
    call emit_dynamic_raw_wrapper(output, "runtime_neg_any")
    call emit_dynamic_raw_wrapper(output, "runtime_pow_any")
    call emit_dynamic_raw_wrapper(output, "runtime_add_any")
    call emit_dynamic_raw_wrapper(output, "runtime_sub_any")
    call emit_dynamic_raw_wrapper(output, "runtime_mul_any")
    call emit_contains(output)
    call emit_dict_hash(output)
    call emit_dict_probe(output)
    call emit_dict_index_insert(output)
    call emit_dict_reindex(output)
    call emit_dict_new(output)
    call emit_dict_get(output)
    call emit_dict_keys(output)
    call emit_dict_delete(output)
    call emit_dict_grow(output)
    call emit_dict_set(output)
end
