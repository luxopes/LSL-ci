    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "type_code_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "type_code_none")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
