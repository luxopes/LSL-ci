function emit_set(output):
    call assembler.label(output, "runtime_set")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 132], "runtime_set_dict")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 132], "runtime_set_byte_array")
    # Typed-array slots hold raw numeric bits. Storing an Any value verbatim
    # planted boxed-Int/Float POINTERS in IntArray/FloatArray slots; the GC
    # (correctly) never traces raw slots, so those hidden boxes were freed by
    # the next gc() and later reads returned recycled garbage.
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "runtime_set_int_array")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "runtime_set_float_array")
    call assembler.relative(output, [233], "runtime_list_set")
    call assembler.label(output, "runtime_set_int_array")
    call assembler.emit(output, x86_64.push(7))
    call assembler.emit(output, x86_64.push(6))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.pop(6))
    call assembler.emit(output, x86_64.pop(7))
    call assembler.relative(output, [233], "runtime_list_set")
    call assembler.label(output, "runtime_set_float_array")
    call assembler.emit(output, x86_64.push(7))
    call assembler.emit(output, x86_64.push(6))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_float")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.pop(6))
    call assembler.emit(output, x86_64.pop(7))
    call assembler.relative(output, [233], "runtime_list_set")
    call assembler.label(output, "runtime_set_byte_array")
    call assembler.emit(output, x86_64.push(7))
    call assembler.emit(output, x86_64.push(6))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.pop(6))
    call assembler.emit(output, x86_64.pop(7))
    call assembler.relative(output, [233], "runtime_byte_array_set")
    call assembler.label(output, "runtime_set_dict")
    call assembler.relative(output, [233], "runtime_dict_set")
end

