end

function emit_is_float(output):
    # reg7 = value -> reg0 = 1 if boxed Float (type 6), else 0.
    call assembler.label(output, "runtime_is_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "is_float_no")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "is_float_no")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "is_float_no")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_coerce_float(output):
    # reg7 = value -> reg0 = boxed Float. Raw Int is promoted; a boxed Float
    # (or any heap value) is returned as-is.
    call assembler.label(output, "runtime_coerce_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "coerce_from_int")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "coerce_from_int")
    call assembler.relative(output, [233], "runtime_float_from_int")
end

function emit_abs_any(output):
    # reg7 = value -> reg0 = abs. Boxed Float clears the sign bit and reboxes;
    # raw Int negates when negative.
    call assembler.label(output, "runtime_abs_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "abs_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 9223372036854775807))
    call assembler.emit(output, x86_64.and_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "abs_any_int")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "abs_any_done")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.label(output, "abs_any_done")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_compare_any(output):
    # reg7=left, reg6=right -> reg0 = -1/0/1 (left <=> right). If either is a
    # boxed Float, both are coerced to double and compared; else signed Int.
    call assembler.label(output, "runtime_compare_any")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(0, 0, 8))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(1, 0, 8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.compare_double(0, 1))
    call assembler.relative(output, [15, 130], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_less")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 140], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_neg_any(output):
    # reg7 = value -> reg0 = negation. Boxed Float flips its sign bit and
    # reboxes; raw Int negates.
    call assembler.label(output, "runtime_neg_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "neg_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, -9223372036854775808))
    call assembler.emit(output, x86_64.add_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "neg_any_int")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_num_any(output, name, float_routine, is_add):
    # reg7,reg6 = operands. If either is a boxed Float, promote both to Float
    # and use float_routine (fixes mixed raw-Int + boxed-Float). Otherwise
    # raw Int op, or (add only) String concat when both are Strings.
    scalar_label = name + "_scalar"
    int_label = name + "_int"
    call assembler.label(output, name)
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], scalar_label)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], float_routine)
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, scalar_label)
    if is_add:
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -16))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.emit(output, x86_64.load_stack(6, -16))
        call assembler.relative(output, [232], "runtime_string_concat")
        call assembler.emit(output, x86_64.function_epilogue())
    end
    call assembler.label(output, int_label)
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    if name == "runtime_add_any":
        call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    elif name == "runtime_sub_any":
        call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    else:
        call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    end
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_contains(output):
    call assembler.label(output, "runtime_contains")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "contains_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 3))
    call assembler.relative(output, [15, 132], "contains_dict")
    call assembler.emit(output, x86_64.load_memory(8, 7, 24))
    call assembler.relative(output, [233], "contains_ready")
    call assembler.label(output, "contains_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_string_contains")
    call assembler.label(output, "contains_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "contains_false")
    call assembler.relative(output, [233], "contains_true")
    call assembler.label(output, "contains_ready")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.label(output, "contains_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "contains_false")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "contains_true")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.relative(output, [233], "contains_loop")
    call assembler.label(output, "contains_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "contains_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Dictionary hash index: parallel keys@24/values@32 arrays stay in insertion
# order; index@40 is an open-addressed table of pos+1 slots (0 = empty),
# index_cap@48 slots (power of two, always >= 2*capacity). djb2 string hash.
function emit_dict_hash(output):
    call assembler.label(output, "runtime_string_hash")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, 5381))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "string_hash_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 1))
    call assembler.relative(output, [15, 141], "string_hash_done")
    call assembler.emit(output, x86_64.move_reg_reg(10, 0))
    call assembler.emit(output, x86_64.shift_left_imm(10, 5))
    call assembler.emit(output, x86_64.add_reg_reg(10, 0))
    call assembler.emit(output, x86_64.load_byte_indexed(2, 8, 9))
    call assembler.emit(output, x86_64.add_reg_reg(10, 2))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "string_hash_loop")
    call assembler.label(output, "string_hash_done")
    call assembler.emit(output, x86_64.ret())
    # Hashable dict key -> hash consistent with runtime_equal_any: raw scalar
    # (Int/Bool/None/Function) hashes to its value; String uses djb2; a boxed
    # scalar hashes its payload word.
    call assembler.label(output, "runtime_key_hash")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "key_hash_heap")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "key_hash_heap")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "runtime_string_hash")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
end

function emit_dict_probe(output):
    # reg7=dict, reg6=key(String). Returns reg0=slot, reg1=index[slot] (0 if absent).
    call assembler.label(output, "runtime_dict_probe")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_probe_linear")
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_key_hash")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.label(output, "dict_probe_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_probe_empty")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_found")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_probe_loop")
    call assembler.label(output, "dict_probe_found")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_empty")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    # No index yet (small dict): linear scan of insertion-order keys.
    call assembler.label(output, "dict_probe_linear")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "dict_probe_linear_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_probe_linear_loop")
    call assembler.label(output, "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_index_insert(output):
    # reg7=dict, reg6=key, reg2=pos. Stores pos+1 into the first empty slot.
    call assembler.label(output, "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-40, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_key_hash")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.label(output, "dict_insert_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_insert_store")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_insert_loop")
    call assembler.label(output, "dict_insert_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 2))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_reindex(output):
    # reg7=dict. Zero index_cap slots, then reinsert every key by position.
    call assembler.label(output, "runtime_dict_reindex")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_memory(9, 7, 48))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dict_reindex_zero")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_reindex_zero")
    call assembler.label(output, "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.label(output, "dict_reindex_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_reindex_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(6, 9, 2, 3))
    call assembler.relative(output, [232], "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.relative(output, [233], "dict_reindex_loop")
    call assembler.label(output, "dict_reindex_done")
    call assembler.emit(output, x86_64.function_epilogue())
end

