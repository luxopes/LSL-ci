function emit_length(output):
    call assembler.label(output, "runtime_length")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "length_string")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "length_string")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.lea_base(11, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "length_string_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "length_string_done")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 9))
    call assembler.emit(output, x86_64.and_reg_imm8(0, 192))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 132], "length_string_continue")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.label(output, "length_string_continue")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "length_string_loop")
    call assembler.label(output, "length_string_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.ret())
end

function emit_get(output):
    call assembler.label(output, "runtime_get")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "runtime_get_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 3))
    call assembler.relative(output, [15, 132], "runtime_get_dict")
    call assembler.relative(output, [233], "runtime_get_list")
    call assembler.label(output, "runtime_get_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_length")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "get_string_index_ready")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.label(output, "get_string_index_ready")
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(11, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "get_string_seek")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 6))
    call assembler.relative(output, [15, 141], "get_string_found")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "get_string_seek_one")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "get_string_seek_two")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "get_string_seek_three")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 4))
    call assembler.relative(output, [233], "get_string_seek_next")
    call assembler.label(output, "get_string_seek_three")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 3))
    call assembler.relative(output, [233], "get_string_seek_next")
    call assembler.label(output, "get_string_seek_two")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 2))
    call assembler.relative(output, [233], "get_string_seek_next")
    call assembler.label(output, "get_string_seek_one")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.label(output, "get_string_seek_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "get_string_seek")
    call assembler.label(output, "get_string_found")
    call assembler.emit(output, x86_64.store_stack(-24, 9))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 9))
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "get_string_size_ready")
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "get_string_size_ready")
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "get_string_size_ready")
    call assembler.emit(output, x86_64.mov_imm64(2, 4))
    call assembler.label(output, "get_string_size_ready")
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.store_memory(0, 8, 2))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 9, 0))
    call assembler.emit(output, x86_64.load_stack(8, -40))
    call assembler.emit(output, x86_64.lea_base(8, 8, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.label(output, "get_string_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 2))
    call assembler.relative(output, [15, 141], "get_string_copy_done")
    call assembler.emit(output, x86_64.load_byte_indexed(1, 7, 9))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "get_string_copy")
    call assembler.label(output, "get_string_copy_done")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 1))
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_get_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_dict_get")
    call assembler.label(output, "runtime_get_list")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "get_list_index_ready")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.add_reg_reg(6, 1))
    call assembler.label(output, "get_list_index_ready")
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(0, 0, 6, 3))
    call assembler.emit(output, x86_64.function_epilogue())
