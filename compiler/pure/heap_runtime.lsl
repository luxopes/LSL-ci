function emit_list_append(output):
    call assembler.label(output, "runtime_list_append")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    # Appending an Any value to a typed array must store raw bits, never a
    # boxed-scalar pointer (the GC does not trace typed-array slots).
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 13))
    call assembler.relative(output, [15, 132], "list_append_unbox_int")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 14))
    call assembler.relative(output, [15, 132], "list_append_unbox_float")
    # A ByteArray reached through a dynamically typed name (a parameter, a
    # list element) lands here too: byte storage holds raw bytes, so the
    # value must be unboxed and stored by the byte append path. Without
    # this the boxed pointer was written into the bytes themselves, which
    # silently corrupted every buffer built through a helper function.
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 15))
    call assembler.relative(output, [15, 132], "list_append_bytes")
    call assembler.relative(output, [233], "list_append_value_ready")
    call assembler.label(output, "list_append_bytes")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_byte_array_append")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "list_append_unbox_int")
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.relative(output, [233], "list_append_unboxed")
    call assembler.label(output, "list_append_unbox_float")
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_float")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.label(output, "list_append_unboxed")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.label(output, "list_append_value_ready")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 140], "list_append_store")
    call assembler.emit(output, x86_64.cmp_reg_imm32(9, 67108864))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    # Grow data capacity by two and copy live elements.
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_stack(-24, 9))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-32, 10))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.label(output, "list_grow_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "list_grow_done")
    call assembler.emit(output, x86_64.load_indexed(1, 10, 2, 3))
    call assembler.emit(output, x86_64.load_stack(11, -40))
    call assembler.emit(output, x86_64.store_indexed(11, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "list_grow_copy")
    call assembler.label(output, "list_grow_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.store_memory(7, 16, 9))
    call assembler.emit(output, x86_64.load_stack(10, -40))
    call assembler.emit(output, x86_64.store_memory(7, 24, 10))
    call assembler.label(output, "list_append_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.store_indexed(10, 8, 3, 6))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.emit(output, x86_64.store_memory(7, 8, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
