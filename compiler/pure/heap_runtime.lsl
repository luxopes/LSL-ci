# Bootstrap heap routines for the tagged direct runtime.
# Object layout: [type:u64, length:u64, capacity:u64, data:pointer].

load assembler
load bytes
load x86_64

function emit_pending_error_data(output, label, message):
    call assembler.label(output, label)
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_pending_error_return(output, label, data_label, message):
    call assembler.label(output, label)
    call assembler.relative(output, x86_64.lea_rip_prefix(11), data_label)
    call assembler.emit(output, x86_64.store_fs(0, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(8, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_data(output, data_label, message)
end

function emit_allocator(output):
    # RBX points at a 160-byte writable state block followed by the intern table.
    call assembler.label(output, "runtime_set_global_roots")
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    call assembler.emit(output, x86_64.store_memory(10, 16, 7))
    call assembler.emit(output, x86_64.store_memory(10, 24, 6))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    # rdi = aligned byte size -> rax = free-list class 0..135. Sizes up to
    # 1024 bytes get exact 8-byte bins (0..127): every block in a bin has
    # exactly the bin size, so the head block always fits and reuse is
    # perfect. Larger sizes use ranges
    # {<=2048, <=4096, <=8192, <=16384, <=65536, <=262144, <=1048576,
    # larger} (128..135);
    # segregated lists keep allocation from linearly scanning millions of
    # small free blocks when a larger request arrives (observed as a
    # near-hang after per-byte boxing churn). rdi is preserved.
    call assembler.label(output, "runtime_size_class")
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 1024))
    call assembler.relative(output, [15, 143], "size_class_large")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 3))
    call assembler.emit(output, x86_64.sub_reg_imm(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "size_class_large")
    call assembler.emit(output, x86_64.mov_imm64(0, 128))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 2048))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 4096))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 8192))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 16384))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 65536))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 262144))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 1048576))
    call assembler.relative(output, [15, 142], "size_class_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.label(output, "size_class_done")
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_alloc")
    # Reject wrapped or implausibly large requests before the alignment add.
    # Without this guard, size+7 could wrap to a small allocation and callers
    # would then copy the original, attacker-controlled length past the heap
    # block. A one-GiB single-object ceiling prevents overcommit/OOM abuse and
    # keeps every container growth calculation inside the signed range.
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.mov_imm64(0, 1073741824))
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 0))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-48, 7))
    call assembler.relative(output, [232], "runtime_mutex_lock")
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 7))
    call assembler.emit(output, x86_64.and_reg_imm8(7, 248))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    # Segregated free lists: start at the request's size class and walk
    # upward. Only the starting class can hold blocks smaller than the
    # request; every higher class is strictly larger, so the size check
    # rejects at most the blocks of one class.
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_size_class")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    # Range classes 128..134 allocate their class ceiling, so every block in
    # such a class has the identical size and the head block always fits,
    # exactly like the 8-byte bins. Only the unbounded top class stays
    # first-fit. Without this, blocks past the probe budget accumulated
    # forever and the heap leaked.
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 140], "alloc_ceiling_done")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 135))
    call assembler.relative(output, [15, 141], "alloc_ceiling_done")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 133], "alloc_ceiling_0")
    call assembler.emit(output, x86_64.mov_imm64(7, 2048))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_0")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 129))
    call assembler.relative(output, [15, 133], "alloc_ceiling_1")
    call assembler.emit(output, x86_64.mov_imm64(7, 4096))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_1")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 130))
    call assembler.relative(output, [15, 133], "alloc_ceiling_2")
    call assembler.emit(output, x86_64.mov_imm64(7, 8192))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_2")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 131))
    call assembler.relative(output, [15, 133], "alloc_ceiling_3")
    call assembler.emit(output, x86_64.mov_imm64(7, 16384))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_3")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 132))
    call assembler.relative(output, [15, 133], "alloc_ceiling_4")
    call assembler.emit(output, x86_64.mov_imm64(7, 65536))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_4")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 133))
    call assembler.relative(output, [15, 133], "alloc_ceiling_5")
    call assembler.emit(output, x86_64.mov_imm64(7, 262144))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_5")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 134))
    call assembler.relative(output, [15, 133], "alloc_ceiling_6")
    call assembler.emit(output, x86_64.mov_imm64(7, 1048576))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [233], "alloc_ceiling_done")
    call assembler.label(output, "alloc_ceiling_6")
    call assembler.label(output, "alloc_ceiling_done")
    call assembler.label(output, "alloc_class_loop")
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 135))
    call assembler.relative(output, [15, 143], "alloc_new")
    call assembler.emit(output, x86_64.shift_left_imm(1, 3))
    call assembler.emit(output, x86_64.add_reg_imm32(1, 192))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.emit(output, x86_64.lea_indexed(11, 10, 1, 0))
    call assembler.emit(output, x86_64.load_memory(8, 11, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    # Bounded probe budget per class: exact bins fit at the head, and every
    # class above the starting one only holds larger blocks, so a long scan
    # can never pay off. The budget keeps the worst case O(1).
    call assembler.emit(output, x86_64.mov_imm64(1, 128))
    call assembler.emit(output, x86_64.store_stack(-64, 1))
    call assembler.label(output, "alloc_reuse_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "alloc_class_next")
    call assembler.emit(output, x86_64.load_stack(1, -64))
    call assembler.emit(output, x86_64.sub_reg_imm(1, 1))
    call assembler.emit(output, x86_64.store_stack(-64, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "alloc_class_next")
    call assembler.emit(output, x86_64.load_memory(1, 8, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "alloc_reuse_next")
    call assembler.emit(output, x86_64.load_memory(1, 8, 0))
    call assembler.emit(output, x86_64.load_stack(2, -8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 140], "alloc_reuse_next")
    call assembler.emit(output, x86_64.load_memory(1, 8, 24))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 133], "alloc_unlink_previous")
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.lea_indexed(9, 10, 2, 0))
    call assembler.emit(output, x86_64.store_memory(9, 0, 1))
    call assembler.relative(output, [233], "alloc_unlinked")
    call assembler.label(output, "alloc_unlink_previous")
    call assembler.emit(output, x86_64.store_memory(2, 24, 1))
    call assembler.label(output, "alloc_unlinked")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.emit(output, x86_64.lea_base(7, 8, 32))
    call assembler.relative(output, [232], "runtime_register_object")
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.relative(output, [232], "runtime_mutex_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -56))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "alloc_reuse_next")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.load_memory(8, 8, 24))
    call assembler.relative(output, [233], "alloc_reuse_loop")
    call assembler.label(output, "alloc_class_next")
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.relative(output, [233], "alloc_class_loop")
    call assembler.label(output, "alloc_new")
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.add_reg_imm8(1, 32))
    call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 7))
    call assembler.relative(output, [15, 133], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(8, 0, 1))
    call assembler.emit(output, x86_64.load_memory(1, 10, 0))
    call assembler.emit(output, x86_64.store_memory(8, 8, 1))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.emit(output, x86_64.store_memory(10, 0, 8))
    call assembler.emit(output, x86_64.lea_base(7, 8, 32))
    call assembler.relative(output, [232], "runtime_register_object")
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.relative(output, [232], "runtime_mutex_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -56))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "fatal_allocation_data")
    message = "LSL runtime error: MemoryError: allocator or object table exhausted\n"
    call assembler.emit(output, x86_64.mov_imm64(2, len(bytes.utf8(message))))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(0, 60))
    call assembler.emit(output, x86_64.mov_imm64(7, 70))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "fatal_allocation_data")
    call assembler.emit(output, bytes.utf8(message))
    call assembler.label(output, "runtime_fatal_setup")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.relative(output, x86_64.lea_rip_prefix(6), "fatal_setup_data")
    message = "LSL runtime error: OSError: required process protection is unavailable\n"
    call assembler.emit(output, x86_64.mov_imm64(2, len(bytes.utf8(message))))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(0, 60))
    call assembler.emit(output, x86_64.mov_imm64(7, 71))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "fatal_setup_data")
    call assembler.emit(output, bytes.utf8(message))
end

function emit_object_table_growth(output):
    call assembler.label(output, "runtime_grow_object_table")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-24, 7))
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.load_memory(9, 3, 40))
    # Keep doubling and byte-size arithmetic bounded even if registry state is
    # corrupted or a hostile program exhausts the supported object count.
    call assembler.emit(output, x86_64.cmp_reg_imm32(9, 33554431))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 9))
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.shift_left_imm(1, 1))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.store_stack(-40, 2))
    call assembler.emit(output, x86_64.shift_left_imm(1, 3))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    # Allocate the replacement with anonymous mmap. The retired table stays
    # mapped so concurrent is_heap_object probes from other threads keep a
    # valid superset view after the state+32 swap.
    call assembler.emit(output, x86_64.mov_imm64(0, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.load_stack(6, -48))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, 34))
    call assembler.emit(output, x86_64.mov_imm64(8, -1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "grow_object_rehash_loop")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 143], "grow_object_rehash_done")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "grow_object_rehash_next")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.label(output, "grow_object_rehash_probe")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "grow_object_rehash_store")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.relative(output, [233], "grow_object_rehash_probe")
    call assembler.label(output, "grow_object_rehash_store")
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 7))
    call assembler.label(output, "grow_object_rehash_next")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "grow_object_rehash_loop")
    call assembler.label(output, "grow_object_rehash_done")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.store_memory(3, 32, 8))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_memory(3, 40, 9))
    # Keep the retired table mapped: concurrent runtime_is_heap_object probes
    # from other threads may still hold its address, and retired tables remain
    # valid supersets of the active one.
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_object_checks(output):
    # The main frame reserves a zeroed open-addressed table at state+32/+40 and
    # its unique-entry count at state+80. Entries are never removed; a freed
    # block is rejected by its GC header.
    call assembler.label(output, "runtime_register_object")
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.load_memory(9, 3, 40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.move_reg_reg(11, 0))
    call assembler.label(output, "register_object_probe")
    call assembler.emit(output, x86_64.load_indexed(10, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 132], "register_object_candidate")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 7))
    call assembler.relative(output, [15, 132], "register_object_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 11))
    call assembler.relative(output, [15, 132], "register_object_grow")
    call assembler.relative(output, [233], "register_object_probe")
    call assembler.label(output, "register_object_grow")
    call assembler.relative(output, [232], "runtime_grow_object_table")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [233], "runtime_register_object")
    call assembler.label(output, "register_object_candidate")
    # Grow before the linear-probing table exceeds 50% occupancy. Waiting for a
    # complete wrap made correlated heap addresses pathologically slow.
    call assembler.emit(output, x86_64.load_memory(1, 3, 80))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_left_imm(2, 1))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 140], "register_object_store")
    call assembler.relative(output, [232], "runtime_grow_object_table")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [233], "runtime_register_object")
    call assembler.label(output, "register_object_store")
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 7))
    call assembler.emit(output, x86_64.load_memory(1, 3, 80))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_memory(3, 80, 1))
    call assembler.label(output, "register_object_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "runtime_is_heap_object")
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.load_memory(9, 3, 40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.move_reg_reg(11, 0))
    call assembler.label(output, "is_heap_object_probe")
    call assembler.emit(output, x86_64.load_indexed(10, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 132], "is_heap_object_false")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 7))
    call assembler.relative(output, [15, 132], "is_heap_object_found")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 11))
    call assembler.relative(output, [15, 132], "is_heap_object_false")
    call assembler.relative(output, [233], "is_heap_object_probe")
    call assembler.label(output, "is_heap_object_found")
    call assembler.emit(output, x86_64.load_memory(1, 7, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "is_heap_object_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "is_heap_object_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_test_small_tables")
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "small_object_clear")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 8))
    call assembler.relative(output, [15, 141], "small_intern_begin")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "small_object_clear")
    call assembler.label(output, "small_intern_begin")
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "small_intern_clear")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 16))
    call assembler.relative(output, [15, 141], "small_tables_ready")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "small_intern_clear")
    call assembler.label(output, "small_tables_ready")
    call assembler.emit(output, x86_64.store_memory_imm32(3, 40, 7))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 56, 7))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 80, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_object_table_mask")
    call assembler.emit(output, x86_64.load_memory(0, 3, 40))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_intern_table_mask")
    call assembler.emit(output, x86_64.load_memory(0, 3, 56))
    call assembler.emit(output, x86_64.ret())
end

function emit_parse_literal_int(output):
    # Compiler trust-core helper: parse an already lexer-validated unsigned
    # decimal token directly to a wrapping raw Int. It deliberately bypasses
    # Any classification, so high-memory self-host builds cannot confuse the
    # token String pointer with a scalar value.
    call assembler.label(output, "runtime_parse_literal_int")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.emit(output, x86_64.mov_imm64(11, 48))
    call assembler.label(output, "parse_literal_int_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "parse_literal_int_done")
    call assembler.emit(output, x86_64.load_byte_indexed(1, 7, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(1, 11))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 10))
    call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "parse_literal_int_loop")
    call assembler.label(output, "parse_literal_int_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_int_power(output):
    # reg7 = base, reg6 = a non-negative exponent. Exponentiation by squaring
    # bounds the work to 64 iterations even for an attacker-controlled Int.
    # Multiplication intentionally keeps the language's wrapping Int semantics.
    call assembler.label(output, "runtime_int_power")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.label(output, "int_power_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "int_power_done")
    call assembler.emit(output, x86_64.move_reg_reg(8, 6))
    call assembler.emit(output, x86_64.and_reg_imm8(8, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "int_power_shift")
    call assembler.emit(output, x86_64.imul_reg_reg(0, 7))
    call assembler.label(output, "int_power_shift")
    call assembler.emit(output, x86_64.shift_right_logical_imm(6, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "int_power_done")
    call assembler.emit(output, x86_64.imul_reg_reg(7, 7))
    call assembler.relative(output, [233], "int_power_loop")
    call assembler.label(output, "int_power_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_float_power(output):
    # reg7 = boxed Float base, reg6 = raw Int exponent. Exponentiation by
    # squaring bounds attacker-controlled work to 64 iterations. A negative
    # exponent, including INT64_MIN, uses the reciprocal.
    call assembler.label(output, "runtime_float_power")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "float_power_loop")
    call assembler.emit(output, x86_64.mov_imm64(8, 1))
    call assembler.emit(output, x86_64.neg_reg(6))
    call assembler.label(output, "float_power_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "float_power_reduced")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.and_reg_imm8(9, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "float_power_shift")
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.label(output, "float_power_shift")
    call assembler.emit(output, x86_64.shift_right_logical_imm(6, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "float_power_reduced")
    call assembler.emit(output, x86_64.mul_double(1, 1))
    call assembler.relative(output, [233], "float_power_loop")
    call assembler.label(output, "float_power_reduced")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "float_power_box")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(2, 0))
    call assembler.emit(output, x86_64.div_double(2, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 2))
    call assembler.relative(output, [233], "float_power_new")
    call assembler.label(output, "float_power_box")
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.label(output, "float_power_new")
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_concat(output):
    call assembler.label(output, "runtime_string_concat")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 6, 8))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 8))
    call assembler.emit(output, x86_64.add_reg_reg(7, 9))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.move_reg_reg(1, 8))
    call assembler.emit(output, x86_64.add_reg_reg(1, 9))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.lea_base(10, 0, 16))

    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.move_reg_reg(1, 8))
    call assembler.label(output, "concat_left_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "concat_right")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 6, 0))
    call assembler.emit(output, x86_64.store_byte_reg_disp(10, 0, 0))
    call assembler.emit(output, x86_64.increment(6))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.relative(output, [233], "concat_left_loop")

    call assembler.label(output, "concat_right")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.label(output, "concat_right_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "concat_done")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 6, 0))
    call assembler.emit(output, x86_64.store_byte_reg_disp(10, 0, 0))
    call assembler.emit(output, x86_64.increment(6))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.relative(output, [233], "concat_right_loop")
    call assembler.label(output, "concat_done")
    call assembler.emit(output, x86_64.store_byte_imm(10, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_intern_table_growth(output):
    call assembler.label(output, "runtime_grow_intern_table")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_memory(9, 3, 56))
    call assembler.emit(output, x86_64.cmp_reg_imm32(9, 16777215))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 9))
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.shift_left_imm(1, 1))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.store_stack(-40, 2))
    call assembler.emit(output, x86_64.shift_left_imm(1, 4))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.add_reg_reg(7, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 7))
    call assembler.relative(output, [15, 133], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "grow_intern_rehash_loop")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 143], "grow_intern_rehash_done")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.move_reg_reg(10, 2))
    call assembler.emit(output, x86_64.shift_left_imm(10, 1))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 10, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "grow_intern_rehash_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_indexed(6, 8, 10, 3))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.label(output, "grow_intern_rehash_probe")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.move_reg_reg(10, 0))
    call assembler.emit(output, x86_64.shift_left_imm(10, 1))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 10, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "grow_intern_rehash_store")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.relative(output, [233], "grow_intern_rehash_probe")
    call assembler.label(output, "grow_intern_rehash_store")
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 7))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 6))
    call assembler.label(output, "grow_intern_rehash_next")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "grow_intern_rehash_loop")
    call assembler.label(output, "grow_intern_rehash_done")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.store_memory(3, 48, 8))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_memory(3, 56, 9))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_clone(output):
    call assembler.label(output, "runtime_string_clone")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
