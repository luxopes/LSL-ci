    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_memory(9, 3, 56))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.relative(output, [233], "string_clone_probe")
    call assembler.label(output, "string_clone_cached")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_indexed(0, 8, 10, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "string_clone_allocate")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "string_clone_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "string_clone_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "string_clone_loop")
    call assembler.label(output, "string_clone_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 1, 8))
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.emit(output, x86_64.shift_left_imm(10, 1))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 1))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 1))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_binary(output, name, operation):
    call assembler.label(output, name)
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.scalar_double(operation, 0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_candidate_byte(output, value):
    # Append one ASCII byte to the candidate buffer (r8 + r9).
    call assembler.emit(output, x86_64.lea_indexed(0, 8, 9, 0))
    call assembler.emit(output, x86_64.store_byte_imm(0, value))
    call assembler.emit(output, x86_64.increment(9))
end

function emit_float_runtime(output):
    call assembler.label(output, "runtime_float_new")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 16))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 6))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_float_from_int")
    call assembler.emit(output, x86_64.int_to_double(0, 7))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [233], "runtime_float_new")
    # Mutate a parser-private Float: value = value * 10.0 + digit. The public
    # decimal parser allocates the accumulator once instead of twice per digit.
    call assembler.label(output, "runtime_float_accumulate")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 10))
    call assembler.emit(output, x86_64.int_to_double(1, 0))
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.int_to_double(2, 6))
    call assembler.emit(output, x86_64.add_double(0, 2))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 0))
    call assembler.emit(output, x86_64.store_memory(7, 8, 0))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    # Parse only formatter-generated, positive decimal candidates. Inputs are
    # already valid and contain a decimal point plus an optional signed
    # exponent, so this leaf routine needs neither validation nor heap objects.
    # r11 is the phase (integer/fraction/exponent), r7 the exponent magnitude,
    # and r6 its sign.
    call assembler.label(output, "runtime_float_candidate_parse")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(1, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 10))
    call assembler.emit(output, x86_64.int_to_double(3, 0))
    call assembler.label(output, "float_candidate_parse_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 9))
    call assembler.relative(output, [15, 141], "float_candidate_parse_done")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 8, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 46))
    call assembler.relative(output, [15, 133], "float_candidate_parse_marker")
    call assembler.emit(output, x86_64.mov_imm64(11, 1))
    call assembler.relative(output, [233], "float_candidate_parse_next")
    call assembler.label(output, "float_candidate_parse_marker")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 101))
    call assembler.relative(output, [15, 133], "float_candidate_parse_digit")
    call assembler.emit(output, x86_64.mov_imm64(11, 2))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_byte_indexed(2, 8, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 45))
    call assembler.relative(output, [15, 133], "float_candidate_parse_next")
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.relative(output, [233], "float_candidate_parse_next")
    call assembler.label(output, "float_candidate_parse_digit")
    call assembler.emit(output, x86_64.add_reg_imm8(2, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(11, 2))
    call assembler.relative(output, [15, 133], "float_candidate_parse_mantissa")
    call assembler.emit(output, x86_64.imul_reg_imm(7, 7, 10))
    call assembler.emit(output, x86_64.add_reg_reg(7, 2))
    call assembler.relative(output, [233], "float_candidate_parse_next")
    call assembler.label(output, "float_candidate_parse_mantissa")
    call assembler.emit(output, x86_64.mul_double(0, 3))
    call assembler.emit(output, x86_64.int_to_double(2, 2))
    call assembler.emit(output, x86_64.add_double(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(11, 0))
    call assembler.relative(output, [15, 132], "float_candidate_parse_next")
    call assembler.emit(output, x86_64.mul_double(1, 3))
    call assembler.label(output, "float_candidate_parse_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "float_candidate_parse_loop")

    call assembler.label(output, "float_candidate_parse_done")
    call assembler.emit(output, x86_64.div_double(0, 1))
    call assembler.label(output, "float_candidate_parse_scale_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "float_candidate_parse_result")
    call assembler.emit(output, x86_64.move_reg_reg(10, 7))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 22))
    call assembler.relative(output, [15, 142], "float_candidate_parse_scale_step")
    call assembler.emit(output, x86_64.mov_imm64(10, 22))
    call assembler.label(output, "float_candidate_parse_scale_step")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(1, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.label(output, "float_candidate_parse_scale_build")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 10))
    call assembler.relative(output, [15, 141], "float_candidate_parse_scale_apply")
    call assembler.emit(output, x86_64.mul_double(1, 3))
    call assembler.emit(output, x86_64.increment(11))
    call assembler.relative(output, [233], "float_candidate_parse_scale_build")
    call assembler.label(output, "float_candidate_parse_scale_apply")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "float_candidate_parse_multiply")
    call assembler.emit(output, x86_64.div_double(0, 1))
    call assembler.relative(output, [233], "float_candidate_parse_scale_advance")
    call assembler.label(output, "float_candidate_parse_multiply")
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.label(output, "float_candidate_parse_scale_advance")
    call assembler.emit(output, x86_64.sub_reg_reg(7, 10))
    call assembler.relative(output, [233], "float_candidate_parse_scale_loop")
    call assembler.label(output, "float_candidate_parse_result")
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 0))
    call assembler.emit(output, x86_64.ret())

    # Convert the formatter's abstract decimal (significand, digit count,
    # decimal exponent) without heap allocation. A compact temporary String is
    # assembled in this stack frame and parsed by the candidate-only leaf above.
    call assembler.label(output, "runtime_float_candidate_bits")
    call assembler.emit(output, x86_64.function_prologue(160))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.lea_base(11, 5, -64))
    # Write significand digits right-to-left. Signed division is safe here:
    # formatter significands are positive and at most 17 decimal digits.
    call assembler.emit(output, x86_64.load_stack(10, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 1))
    call assembler.relative(output, [15, 133], "float_candidate_digits_many")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.add_reg_imm8(0, 48))
    call assembler.emit(output, x86_64.store_byte_reg_disp(11, 0, 0))
    call assembler.relative(output, [233], "float_candidate_compose")
    call assembler.label(output, "float_candidate_digits_many")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(10, -16))
    call assembler.emit(output, x86_64.decrement(10))
    call assembler.emit(output, x86_64.mov_imm64(1, 10))
    call assembler.label(output, "float_candidate_digits_loop")
    call assembler.emit(output, x86_64.cqo())
    call assembler.emit(output, x86_64.idiv_reg(1))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 48))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 10, 2))
    call assembler.emit(output, x86_64.decrement(10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 141], "float_candidate_digits_loop")

    call assembler.label(output, "float_candidate_compose")
    call assembler.emit(output, x86_64.lea_base(8, 5, -128))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "float_candidate_negative_exponent")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 16))
    call assembler.relative(output, [15, 140], "float_candidate_fixed_positive")
    call assembler.relative(output, [233], "float_candidate_scientific")
    call assembler.label(output, "float_candidate_negative_exponent")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, -7))
    call assembler.relative(output, [15, 142], "float_candidate_scientific")
    call assembler.relative(output, [233], "float_candidate_fixed_negative")

    call assembler.label(output, "float_candidate_fixed_positive")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "float_candidate_fixed_integer")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_fixed_zeros")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_fixed_dot")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_candidate_fixed_integer")
    call assembler.label(output, "float_candidate_fixed_zeros")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_fixed_dot")
    call emit_float_candidate_byte(output, 48)
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "float_candidate_fixed_zeros")
    call assembler.label(output, "float_candidate_fixed_dot")
    call emit_float_candidate_byte(output, 46)
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 140], "float_candidate_fixed_fraction")
    call emit_float_candidate_byte(output, 48)
    call assembler.relative(output, [233], "float_candidate_ready")
    call assembler.label(output, "float_candidate_fixed_fraction")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_ready")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_candidate_fixed_fraction")

    call assembler.label(output, "float_candidate_fixed_negative")
    call emit_float_candidate_byte(output, 48)
    call emit_float_candidate_byte(output, 46)
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.neg_reg(10))
    call assembler.emit(output, x86_64.decrement(10))
    call assembler.label(output, "float_candidate_leading_zeros")
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 142], "float_candidate_copy_all_start")
    call emit_float_candidate_byte(output, 48)
    call assembler.emit(output, x86_64.decrement(10))
    call assembler.relative(output, [233], "float_candidate_leading_zeros")
    call assembler.label(output, "float_candidate_copy_all_start")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "float_candidate_copy_all")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_ready")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_candidate_copy_all")

    call assembler.label(output, "float_candidate_scientific")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 11, 0))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(9))
    call emit_float_candidate_byte(output, 46)
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 1))
    call assembler.relative(output, [15, 133], "float_candidate_scientific_rest_start")
    call emit_float_candidate_byte(output, 48)
    call assembler.relative(output, [233], "float_candidate_scientific_exponent")
    call assembler.label(output, "float_candidate_scientific_rest_start")
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.label(output, "float_candidate_scientific_rest")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "float_candidate_scientific_exponent")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_candidate_scientific_rest")
    call assembler.label(output, "float_candidate_scientific_exponent")
    call emit_float_candidate_byte(output, 101)
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 140], "float_candidate_exponent_minus")
    call emit_float_candidate_byte(output, 43)
    call assembler.relative(output, [233], "float_candidate_exponent_digits")
    call assembler.label(output, "float_candidate_exponent_minus")
    call emit_float_candidate_byte(output, 45)
    call assembler.emit(output, x86_64.neg_reg(10))
    call assembler.label(output, "float_candidate_exponent_digits")
    # Leading zeroes are harmless to the private parser and make the bounded
    # [-324, 308] exponent path branch-free.
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.mov_imm64(6, 100))
    call assembler.emit(output, x86_64.cqo())
    call assembler.emit(output, x86_64.idiv_reg(6))
    call assembler.emit(output, x86_64.move_reg_reg(10, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(0, 48))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.mov_imm64(6, 10))
    call assembler.emit(output, x86_64.cqo())
    call assembler.emit(output, x86_64.idiv_reg(6))
    call assembler.emit(output, x86_64.move_reg_reg(10, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(0, 48))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.label(output, "float_candidate_exponent_ones")
    call assembler.emit(output, x86_64.add_reg_imm8(10, 48))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 10))
    call assembler.emit(output, x86_64.increment(9))

    call assembler.label(output, "float_candidate_ready")
    call assembler.emit(output, x86_64.lea_base(7, 5, -144))
    call assembler.emit(output, x86_64.store_memory_imm32(7, 0, 1))
    call assembler.emit(output, x86_64.store_memory(7, 8, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 9, 0))
    call assembler.relative(output, [232], "runtime_float_candidate_parse")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_float_to_int")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.double_to_int(0, 0))
    call assembler.emit(output, x86_64.ret())
    call emit_float_binary(output, "runtime_float_add", 88)
    call emit_float_binary(output, "runtime_float_sub", 92)
    call emit_float_binary(output, "runtime_float_mul", 89)
    call emit_float_binary(output, "runtime_float_div", 94)
end

function emit_boxed_scalars(output):
    call assembler.label(output, "runtime_box_bool")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 4))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_box_int")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 9))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_box_function")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 10))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_box_dynamic_function")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "box_dynamic_function_raw")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 10))
    call assembler.relative(output, [15, 133], "box_dynamic_function_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "box_dynamic_function_raw")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_box_function")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_function_return_tag")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "function_return_unknown")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 10))
    call assembler.relative(output, [15, 133], "function_return_unknown")
    call assembler.emit(output, x86_64.load_memory(0, 7, 16))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "function_return_unknown")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.ret())
    # Transitional Any numeric boundary: keep an already tagged heap value,
    # otherwise box the raw signed Int. Call only for expressions known to be
    # numeric-or-heap (for example indexed augmented assignment).
    call assembler.label(output, "runtime_box_dynamic_int")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "box_dynamic_raw_int")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "box_dynamic_raw_int")
    call assembler.relative(output, [233], "runtime_box_int")
    call assembler.label(output, "runtime_box_none")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.mov_imm64(7, 16))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 5))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_type_code")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "type_code_raw")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "type_code_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "type_code_none")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "type_code_none")
    call assembler.emit(output, x86_64.mov_imm64(0, 5))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_unbox_bool")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_unbox_int")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_unbox_dynamic_bool")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "unbox_bool_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 133], "unbox_bool_raw")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "unbox_bool_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    # Callable ABI accepts both the old raw code pointer and tagged type 10.
    call assembler.label(output, "runtime_unbox_dynamic_function")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "unbox_function_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 10))
    call assembler.relative(output, [15, 133], "unbox_function_raw")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "unbox_function_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    # Transitional helper for generic numeric operations: raw Int is returned
    # unchanged, boxed Int and Bool are unboxed. Other heap values remain
    # unchanged so Float/String dispatch can classify them before arithmetic.
    call assembler.label(output, "runtime_unbox_dynamic_int")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "unbox_dynamic_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 132], "unbox_dynamic_tagged_int")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 133], "unbox_dynamic_raw")
    call assembler.label(output, "unbox_dynamic_tagged_int")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "unbox_dynamic_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    # Boxed Float (tag 6) -> raw IEEE bits; anything else passes through.
    call assembler.label(output, "runtime_unbox_dynamic_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "unbox_float_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "unbox_float_raw")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "unbox_float_raw")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_truth")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "truth_raw")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 5))
    call assembler.relative(output, [15, 132], "truth_false")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 132], "truth_boxed_bool")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "truth_collection")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.shift_left_imm(7, 1))
    call assembler.relative(output, [233], "truth_raw")
    call assembler.label(output, "truth_collection")
    # String/List/Dictionary/Tuple/RealArray store length/count at offset 8;
    # empty is falsy like Python.
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.relative(output, [233], "truth_raw")
    call assembler.label(output, "truth_boxed_bool")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.label(output, "truth_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.emit(output, x86_64.set_condition(149))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "truth_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "truth_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_gc(output):
    # Bounded automatic collection at a safe expression boundary. Require both
    # sustained Float formatting and object-registry growth: this avoids a
    # full-heap pause in mixed programs whose first Float appears late, while
    # conversion-heavy loops still collect promptly. After a sweep the
    # allocator can reuse registered addresses without crossing the threshold.
    call assembler.label(output, "runtime_maybe_gc")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.load_fs(2, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 133], "maybe_gc_done")
    call assembler.emit(output, x86_64.load_memory(8, 3, 80))
    call assembler.emit(output, x86_64.load_memory(9, 3, 144))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 133], "maybe_gc_check")
    call assembler.emit(output, x86_64.add_reg_imm32(8, 4096))
    call assembler.emit(output, x86_64.store_memory(3, 144, 8))
    call assembler.relative(output, [233], "maybe_gc_done")
    call assembler.label(output, "maybe_gc_check")
    call assembler.emit(output, x86_64.load_memory(10, 3, 152))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.store_memory(3, 152, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm32(10, 256))
    call assembler.relative(output, [15, 140], "maybe_gc_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 140], "maybe_gc_done")
    call assembler.relative(output, [232], "runtime_gc")
    call assembler.emit(output, x86_64.load_memory(8, 3, 80))
    call assembler.emit(output, x86_64.add_reg_imm32(8, 4096))
    call assembler.emit(output, x86_64.store_memory(3, 144, 8))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 152, 0))
    call assembler.label(output, "maybe_gc_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())

    # Validate the candidate pointer through the object registry (exact payload
    # pointers only; freed blocks are rejected by their GC header), then
    # test-and-set the mark word at block+24. The previous linear walk of the
    # all-objects list made every single mark O(total blocks), so each gc()
    # grew slower as the heap grew — multi-second pauses in GUI programs.
    call assembler.label(output, "runtime_mark_shallow")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "mark_shallow_false")
    call assembler.emit(output, x86_64.load_memory(1, 7, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "mark_shallow_false")
    call assembler.emit(output, x86_64.store_memory_imm32(7, -8, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "mark_shallow_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "runtime_mark")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    # Container graphs are user-controlled. Bound native recursion; when a
    # live graph is deeper, abort this collection and retain every object
    # rather than overflowing the process stack or freeing an unvisited child.
    # state+184 is a signed depth counter, with -1 meaning fail-safe abort.
    call assembler.emit(output, x86_64.load_memory(1, 3, 184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "mark_done")
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 128))
    call assembler.relative(output, [15, 141], "mark_depth_abort")
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_memory(3, 184, 1))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "mark_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 2))
    call assembler.relative(output, [15, 132], "mark_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 7))
    call assembler.relative(output, [15, 132], "mark_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 8))
    call assembler.relative(output, [15, 132], "mark_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 13))
    call assembler.relative(output, [15, 132], "mark_raw_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 14))
    call assembler.relative(output, [15, 132], "mark_raw_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 15))
    call assembler.relative(output, [15, 132], "mark_raw_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 3))
    call assembler.relative(output, [15, 132], "mark_dict")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 12))
    call assembler.relative(output, [15, 132], "mark_native_function")
    call assembler.relative(output, [233], "mark_done")
    call assembler.label(output, "mark_list")
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "mark_list_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "mark_done")
    call assembler.emit(output, x86_64.load_stack(9, -16))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.relative(output, [233], "mark_list_loop")
    call assembler.label(output, "mark_raw_list")
    # Typed-array slots are raw numeric bits, not object references. Keep only
    # their separately allocated backing block alive.
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.relative(output, [233], "mark_done")
    call assembler.label(output, "mark_dict")
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(7, 7, 40))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(7, 7, 32))
    call assembler.emit(output, x86_64.store_stack(-32, 7))
    call assembler.relative(output, [232], "runtime_mark_shallow")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "mark_dict_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "mark_done")
    call assembler.emit(output, x86_64.load_stack(9, -16))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.relative(output, [233], "mark_dict_loop")
    call assembler.label(output, "mark_native_function")
    # A resolved native Function owns its NativeLibrary handle. Without this
    # edge, gc() could recycle the library object while the Function remained
    # reachable and later validation would dereference unrelated object state.
    call assembler.emit(output, x86_64.load_memory(7, 7, 16))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.relative(output, [233], "mark_done")
    call assembler.label(output, "mark_depth_abort")
    call assembler.emit(output, x86_64.mov_imm64(1, -1))
    call assembler.emit(output, x86_64.store_memory(3, 184, 1))
    call assembler.label(output, "mark_done")
    call assembler.emit(output, x86_64.load_memory(1, 3, 184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "mark_return")
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_memory(3, 184, 1))
    call assembler.label(output, "mark_return")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_gc")
    call assembler.emit(output, x86_64.function_prologue(96))
    # Only the main thread may collect; workers return immediately. Their
    # stacks are scanned conservatively below while the main thread holds
    # both mutexes.
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.load_fs(2, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 133], "gc_thread_skip")
    call assembler.relative(output, [232], "runtime_mutex_lock")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_memory(3, 184, 1))
    # Roots the conservative stack scan cannot see: the pending-error String
    # kept only in the thread-local block (fs:0), and the last capture() stderr String at
    # state+72. Both must survive across gc().
    call assembler.emit(output, x86_64.load_fs(7, 0))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_memory(7, 3, 72))
    call assembler.relative(output, [232], "runtime_mark")
    # Conservatively scan the whole live stack, from just above this frame
    # up to the thread stack base (fs:16), so roots held in any live caller
    # frame (not only the immediate one) are marked. Scanning only the
    # direct caller previously let gc() free objects still referenced by
    # outer frames, corrupting long-lived state such as pending input.
    call assembler.emit(output, x86_64.lea_base(8, 5, 16))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.load_fs(8, 16))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.label(output, "gc_root_loop")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "gc_global_start")
    call assembler.emit(output, x86_64.load_memory(7, 8, 0))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.add_reg_imm8(8, 8))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.relative(output, [233], "gc_root_loop")
    call assembler.label(output, "gc_global_start")
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    call assembler.emit(output, x86_64.load_memory(8, 10, 16))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.load_memory(8, 10, 24))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.label(output, "gc_global_loop")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "gc_intern_start")
    call assembler.emit(output, x86_64.load_memory(7, 8, 0))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.add_reg_imm8(8, 8))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.relative(output, [233], "gc_global_loop")
    call assembler.label(output, "gc_intern_start")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.label(output, "gc_intern_loop")
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.load_memory(2, 3, 56))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 143], "gc_thread_start")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_left_imm(2, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "gc_intern_next")
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.label(output, "gc_intern_next")
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.relative(output, [233], "gc_intern_loop")
    call assembler.label(output, "gc_thread_start")
    # Thread stacks: stop the world first. The main thread holds the table
    # mutex, signals every running worker with SIGUSR1 and waits until each
    # handler marks its entry as suspended (status 2). The handlers block on
    # the gate with their registers saved in the kernel sigframe on the
    # worker stack, so the conservative scan below sees every live pointer.
    # Workers that exit meanwhile have their status cleared by the kernel.
    call assembler.relative(output, [232], "runtime_table_lock")
    call assembler.emit(output, x86_64.store_memory_imm32(3, 128, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 39))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-48, 0))
    call assembler.label(output, "gc_suspend_retry")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-56, 1))
    call assembler.emit(output, x86_64.store_stack(-72, 1))
    call assembler.label(output, "gc_suspend_loop")
    call assembler.emit(output, x86_64.load_stack(1, -56))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 127))
    call assembler.relative(output, [15, 141], "gc_suspend_checked")
    call assembler.emit(output, x86_64.load_memory(8, 3, 112))
    call assembler.emit(output, x86_64.move_reg_reg(10, 1))
    call assembler.emit(output, x86_64.shift_left_imm(10, 6))
    call assembler.emit(output, x86_64.lea_indexed(9, 8, 10, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(9, 8))
    call assembler.emit(output, x86_64.load_memory(2, 9, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 4))
    call assembler.relative(output, [15, 132], "gc_suspend_pending")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 1))
    call assembler.relative(output, [15, 133], "gc_suspend_next")
    # Mark the entry signalled (status 4) so it is never signalled twice,
    # then tgkill(pid, ktid, SIGUSR1).
    call assembler.emit(output, x86_64.store_memory_imm32(9, 16, 4))
    call assembler.emit(output, x86_64.load_memory(6, 9, 0))
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.mov_imm64(2, 10))
    call assembler.emit(output, x86_64.mov_imm64(0, 234))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "gc_suspend_pending")
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.store_stack(-72, 2))
    call assembler.label(output, "gc_suspend_next")
    call assembler.emit(output, x86_64.load_stack(1, -56))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-56, 1))
    call assembler.relative(output, [233], "gc_suspend_loop")
    call assembler.label(output, "gc_suspend_checked")
    call assembler.emit(output, x86_64.load_stack(2, -72))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 132], "gc_thread_scan_start")
    call assembler.emit(output, x86_64.pause())
    call assembler.relative(output, [233], "gc_suspend_retry")
    # Scan every suspended worker's live stack from its saved rsp (below the
    # kernel sigframe holding its registers) up to the stack base.
    call assembler.label(output, "gc_thread_scan_start")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.label(output, "gc_thread_loop")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 127))
    call assembler.relative(output, [15, 141], "gc_thread_done")
    call assembler.emit(output, x86_64.load_memory(8, 3, 112))
    call assembler.emit(output, x86_64.move_reg_reg(10, 1))
    call assembler.emit(output, x86_64.shift_left_imm(10, 6))
    call assembler.emit(output, x86_64.lea_indexed(9, 8, 10, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(9, 8))
    call assembler.emit(output, x86_64.load_memory(2, 9, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 2))
    call assembler.relative(output, [15, 133], "gc_thread_next")
    call assembler.emit(output, x86_64.load_memory(10, 9, 8))
    call assembler.emit(output, x86_64.store_stack(-56, 10))
    call assembler.emit(output, x86_64.load_memory(10, 9, 24))
    call assembler.emit(output, x86_64.store_stack(-64, 10))
    call assembler.label(output, "gc_thread_scan")
    call assembler.emit(output, x86_64.load_stack(8, -64))
    call assembler.emit(output, x86_64.load_stack(9, -56))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 131], "gc_thread_next")
    call assembler.emit(output, x86_64.load_memory(7, 8, 0))
    call assembler.relative(output, [232], "runtime_mark")
    call assembler.emit(output, x86_64.load_stack(8, -64))
    call assembler.emit(output, x86_64.add_reg_imm8(8, 8))
    call assembler.emit(output, x86_64.store_stack(-64, 8))
    call assembler.relative(output, [233], "gc_thread_scan")
    call assembler.label(output, "gc_thread_next")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.relative(output, [233], "gc_thread_loop")
    call assembler.label(output, "gc_thread_done")
    call assembler.relative(output, [232], "runtime_table_unlock")
    call assembler.label(output, "gc_sweep_start")
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    call assembler.emit(output, x86_64.load_memory(8, 10, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "gc_sweep_loop")
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "gc_done")
    # Freed blocks first, untouched: their +24 word is the free-list link, not
    # a mark bit. Reading it as a mark (and clearing it) severed the free list
    # on every following collection, so freed memory was never reused and the
    # heap only ever grew.
    call assembler.emit(output, x86_64.load_memory(1, 8, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "gc_sweep_next")
    call assembler.emit(output, x86_64.load_memory(1, 3, 184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "gc_sweep_clear_only")
    call assembler.emit(output, x86_64.load_memory(1, 8, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "gc_free_block")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.relative(output, [233], "gc_sweep_next")
    call assembler.label(output, "gc_sweep_clear_only")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.relative(output, [233], "gc_sweep_next")
    call assembler.label(output, "gc_free_block")
    # NativeLibrary mappings are external resources rather than heap backing
    # blocks. Finalize an unreachable live handle before recycling its object.
    call assembler.emit(output, x86_64.load_memory(2, 8, 32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 11))
    call assembler.relative(output, [15, 133], "gc_finalize_done")
    call assembler.emit(output, x86_64.load_memory(7, 8, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "gc_finalize_done")
    call assembler.emit(output, x86_64.load_memory(6, 8, 48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 64))
    call assembler.relative(output, [15, 140], "gc_finalize_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 11))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "gc_finalize_done")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 1))
    # Push onto the size-class free list matching the block's capacity.
    call assembler.emit(output, x86_64.load_memory(7, 8, 0))
    call assembler.relative(output, [232], "runtime_size_class")
    call assembler.emit(output, x86_64.shift_left_imm(0, 3))
    call assembler.emit(output, x86_64.add_reg_imm32(0, 192))
    call assembler.emit(output, x86_64.lea_indexed(9, 10, 0, 0))
    call assembler.emit(output, x86_64.load_memory(1, 9, 0))
    call assembler.emit(output, x86_64.store_memory(8, 24, 1))
    call assembler.emit(output, x86_64.store_memory(9, 0, 8))
    call assembler.emit(output, x86_64.load_memory(2, 8, 32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 1))
    call assembler.relative(output, [15, 140], "gc_sweep_next")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 8))
    call assembler.relative(output, [15, 143], "gc_sweep_next")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "gc_sweep_next")
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.relative(output, [233], "gc_sweep_loop")
    call assembler.label(output, "gc_done")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_memory(3, 184, 1))
    # Wake the suspended handlers only after the sweep finished.
    call assembler.emit(output, x86_64.store_memory_imm32(3, 128, 0))
    call assembler.emit(output, x86_64.lea_base(7, 3, 128))
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 2147483647))
    call assembler.emit(output, x86_64.mov_imm64(0, 202))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [232], "runtime_mutex_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.emit(output, x86_64.set_condition(149))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "gc_thread_skip")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_byte_array(output):
    call assembler.label(output, "runtime_byte_array_new")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.mov_imm64(7, 32))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 15))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 16, 64))
    call assembler.emit(output, x86_64.mov_imm64(7, 64))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 24, 0))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())

    # runtime_byte_array_zeros: rdi = n -> a zeroed ByteArray of length n
    # allocated in ONE data allocation (not per-element append), so building
    # a large buffer registers 2 objects instead of n and never blows up the
    # object table.
    call assembler.label(output, "runtime_byte_array_zeros")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 1073741824))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 32))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 15))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    # A zero-length ByteArray must still have real append capacity. Previously
    # capacity stayed zero, doubling kept it zero, and append wrote into a
    # zero-byte backing allocation.
    call assembler.emit(output, x86_64.mov_imm64(2, 64))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "byte_zeros_capacity_ready")
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.label(output, "byte_zeros_capacity_ready")
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(1, 24, 0))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "byte_zeros_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "byte_zeros_done")
    call assembler.emit(output, x86_64.load_stack(11, -24))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 2, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "byte_zeros_loop")
    call assembler.label(output, "byte_zeros_done")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_byte_array_append")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 140], "byte_array_append_store")
    call assembler.emit(output, x86_64.cmp_reg_imm32(9, 536870912))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_stack(-24, 9))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-32, 10))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.label(output, "byte_array_grow_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "byte_array_grow_done")
    call assembler.emit(output, x86_64.load_byte_indexed(1, 10, 2))
    call assembler.emit(output, x86_64.load_stack(11, -40))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 2, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "byte_array_grow_copy")
    call assembler.label(output, "byte_array_grow_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.store_memory(7, 16, 9))
    call assembler.emit(output, x86_64.load_stack(10, -40))
    call assembler.emit(output, x86_64.store_memory(7, 24, 10))
    call assembler.label(output, "byte_array_append_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 8, 6))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.emit(output, x86_64.store_memory(7, 8, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_byte_array_get")
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 0, 6))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_byte_array_set")
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.store_byte_indexed(0, 6, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_list_new(output):
    call assembler.label(output, "runtime_list_new")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "runtime_fatal_allocation")
    # Eight-byte slots are shifted before reaching runtime_alloc; reject a
    # count that could overflow that multiplication first.
    call assembler.emit(output, x86_64.cmp_reg_imm32(7, 134217728))
    call assembler.relative(output, [15, 143], "runtime_fatal_allocation")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.mov_imm64(7, 32))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 2))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.mov_imm64(2, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "list_capacity_ready")
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.label(output, "list_capacity_ready")
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
