    call assembler.emit(output, x86_64.load_memory(11, 7, 32))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.label(output, "dict_grow_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_grow_done")
    call assembler.emit(output, x86_64.load_indexed(0, 10, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 0))
    call assembler.emit(output, x86_64.load_indexed(1, 11, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_grow_copy")
    call assembler.label(output, "dict_grow_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.store_memory(7, 16, 9))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_memory(7, 24, 9))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_memory(7, 32, 9))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_memory(7, 48, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.store_memory(7, 40, 0))
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_set(output):
    call assembler.label(output, "runtime_dict_set")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
