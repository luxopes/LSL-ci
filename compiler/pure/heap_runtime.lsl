# Bootstrap heap routines for the tagged direct runtime.
# Object layout: [type:u64, length:u64, capacity:u64, data:pointer].

load assembler
load bytes
load x86_64

function emit_allocator(output):
    # RBX points at a 64-byte writable state block followed by value/intern tables.
    call assembler.label(output, "runtime_set_global_roots")
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    call assembler.emit(output, x86_64.store_memory(10, 16, 7))
    call assembler.emit(output, x86_64.store_memory(10, 24, 6))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_alloc")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 7))
    call assembler.emit(output, x86_64.and_reg_imm8(7, 248))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.move_reg_reg(10, 3))
    call assembler.emit(output, x86_64.load_memory(8, 10, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "alloc_reuse_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "alloc_new")
    call assembler.emit(output, x86_64.load_memory(1, 8, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "alloc_reuse_next")
    call assembler.emit(output, x86_64.load_memory(1, 8, 0))
    call assembler.emit(output, x86_64.load_stack(2, -8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 140], "alloc_reuse_next")
    call assembler.emit(output, x86_64.load_memory(1, 8, 24))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 133], "alloc_unlink_previous")
    call assembler.emit(output, x86_64.store_memory(10, 8, 1))
    call assembler.relative(output, [233], "alloc_unlinked")
    call assembler.label(output, "alloc_unlink_previous")
    call assembler.emit(output, x86_64.store_memory(2, 24, 1))
    call assembler.label(output, "alloc_unlinked")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.emit(output, x86_64.lea_base(7, 8, 32))
    call assembler.relative(output, [232], "runtime_register_object")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "alloc_reuse_next")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.load_memory(8, 8, 24))
    call assembler.relative(output, [233], "alloc_reuse_loop")
    call assembler.label(output, "alloc_new")
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.add_reg_imm8(1, 32))
    call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 12))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(8, 0, 1))
    call assembler.emit(output, x86_64.load_memory(1, 10, 0))
    call assembler.emit(output, x86_64.store_memory(8, 8, 1))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 24, 0))
    call assembler.emit(output, x86_64.store_memory(10, 0, 8))
    call assembler.emit(output, x86_64.lea_base(7, 8, 32))
    call assembler.relative(output, [232], "runtime_register_object")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_object_checks(output):
    # The main frame reserves a zeroed open-addressed table at state+32/+40.
    # Entries are never removed; a freed block is rejected by its GC header.
    call assembler.label(output, "runtime_register_object")
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.load_memory(9, 3, 40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.label(output, "register_object_probe")
    call assembler.emit(output, x86_64.load_indexed(10, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 132], "register_object_store")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 7))
    call assembler.relative(output, [15, 132], "register_object_done")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.relative(output, [233], "register_object_probe")
    call assembler.label(output, "register_object_store")
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 7))
    call assembler.label(output, "register_object_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "runtime_is_heap_object")
    call assembler.emit(output, x86_64.load_memory(8, 3, 32))
    call assembler.emit(output, x86_64.load_memory(9, 3, 40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.label(output, "is_heap_object_probe")
    call assembler.emit(output, x86_64.load_indexed(10, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 132], "is_heap_object_false")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 7))
    call assembler.relative(output, [15, 132], "is_heap_object_found")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.relative(output, [233], "is_heap_object_probe")
    call assembler.label(output, "is_heap_object_found")
    call assembler.emit(output, x86_64.load_memory(1, 7, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "is_heap_object_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "is_heap_object_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_int_power(output):
    call assembler.label(output, "runtime_int_power")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.label(output, "int_power_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 142], "int_power_done")
    call assembler.emit(output, x86_64.imul_reg_reg(0, 7))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.relative(output, [233], "int_power_loop")
    call assembler.label(output, "int_power_done")
    call assembler.emit(output, x86_64.ret())
end

function emit_float_power(output):
    # reg7 = boxed Float base, reg6 = raw Int exponent. Exact repeated
    # multiplication; negative exponent yields the reciprocal.
    call assembler.label(output, "runtime_float_power")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "float_power_loop")
    call assembler.emit(output, x86_64.mov_imm64(8, 1))
    call assembler.emit(output, x86_64.neg_reg(6))
    call assembler.label(output, "float_power_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 142], "float_power_reduced")
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.decrement(6))
    call assembler.relative(output, [233], "float_power_loop")
    call assembler.label(output, "float_power_reduced")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "float_power_box")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.int_to_double(2, 0))
    call assembler.emit(output, x86_64.div_double(2, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 2))
    call assembler.relative(output, [233], "float_power_new")
    call assembler.label(output, "float_power_box")
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.label(output, "float_power_new")
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_concat(output):
    call assembler.label(output, "runtime_string_concat")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 6, 8))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 8))
    call assembler.emit(output, x86_64.add_reg_reg(7, 9))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.move_reg_reg(1, 8))
    call assembler.emit(output, x86_64.add_reg_reg(1, 9))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.lea_base(10, 0, 16))

    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.move_reg_reg(1, 8))
    call assembler.label(output, "concat_left_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "concat_right")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 6, 0))
    call assembler.emit(output, x86_64.store_byte_reg_disp(10, 0, 0))
    call assembler.emit(output, x86_64.increment(6))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.relative(output, [233], "concat_left_loop")

    call assembler.label(output, "concat_right")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.label(output, "concat_right_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "concat_done")
    call assembler.emit(output, x86_64.load_byte_zero_extend(0, 6, 0))
    call assembler.emit(output, x86_64.store_byte_reg_disp(10, 0, 0))
    call assembler.emit(output, x86_64.increment(6))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.relative(output, [233], "concat_right_loop")
    call assembler.label(output, "concat_done")
    call assembler.emit(output, x86_64.store_byte_imm(10, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_clone(output):
    call assembler.label(output, "runtime_string_clone")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_memory(9, 3, 56))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 3))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.label(output, "string_clone_probe")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.move_reg_reg(10, 0))
    call assembler.emit(output, x86_64.shift_left_imm(10, 1))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 10, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "string_clone_allocate")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 7))
    call assembler.relative(output, [15, 132], "string_clone_cached")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.relative(output, [233], "string_clone_probe")
    call assembler.label(output, "string_clone_cached")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_indexed(0, 8, 10, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "string_clone_allocate")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "string_clone_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "string_clone_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "string_clone_loop")
    call assembler.label(output, "string_clone_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 1, 8))
    call assembler.emit(output, x86_64.load_memory(8, 3, 48))
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.emit(output, x86_64.shift_left_imm(10, 1))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 1))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_indexed(8, 10, 3, 1))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_binary(output, name, operation):
    call assembler.label(output, name)
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.scalar_double(operation, 0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_runtime(output):
    call assembler.label(output, "runtime_float_new")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.mov_imm64(7, 16))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 6))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_float_from_int")
    call assembler.emit(output, x86_64.int_to_double(0, 7))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [233], "runtime_float_new")
    call assembler.label(output, "runtime_string_to_float")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.label(output, "string_float_loop")
    call assembler.emit(output, x86_64.load_stack(8, -48))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "string_float_done")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(2, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 45))
    call assembler.relative(output, [15, 133], "string_float_dot")
    call assembler.emit(output, x86_64.store_memory_imm32(5, -40, 1))
    call assembler.relative(output, [233], "string_float_next")
    call assembler.label(output, "string_float_dot")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 46))
    call assembler.relative(output, [15, 133], "string_float_digit")
    call assembler.emit(output, x86_64.store_memory_imm32(5, -32, 1))
    call assembler.relative(output, [233], "string_float_next")
    call assembler.label(output, "string_float_digit")
    call assembler.emit(output, x86_64.add_reg_imm8(2, -48))
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.mov_imm64(10, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 10))
    call assembler.emit(output, x86_64.add_reg_reg(0, 2))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "string_float_next")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.imul_reg_reg(1, 10))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "string_float_next")
    call assembler.emit(output, x86_64.load_stack(8, -48))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.relative(output, [233], "string_float_loop")
    call assembler.label(output, "string_float_done")
