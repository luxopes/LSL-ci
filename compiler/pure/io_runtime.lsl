# Linux x86_64 syscall boundary for the pure runtime.

load assembler
load bytes
load x86_64

function emit_cstring(output):
    call assembler.label(output, "runtime_from_cstring")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "cstring_length")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 7, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 132], "cstring_allocate")
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "cstring_length")
    call assembler.label(output, "cstring_allocate")
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "cstring_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "cstring_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "cstring_copy")
    call assembler.label(output, "cstring_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 1, 8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_input(output):
    call assembler.label(output, "runtime_input")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.relative(output, [232], "runtime_print_string")
    call assembler.emit(output, x86_64.mov_imm64(7, 273))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 256))
    call assembler.emit(output, x86_64.store_stack(-24, 1))

    call assembler.label(output, "input_read_loop")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 133], "input_read_byte")
    # Grow the payload 2x and copy the bytes collected so far.
    call assembler.emit(output, x86_64.shift_left_imm(2, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "input_grow_copy")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "input_grow_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "input_grow_copy")
    call assembler.label(output, "input_grow_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.store_stack(-8, 0))

    call assembler.label(output, "input_read_byte")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.add_reg_reg(6, 2))
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "input_finish")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.load_byte_zero_extend(8, 6, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 10))
    call assembler.relative(output, [15, 133], "input_read_loop")

    call assembler.label(output, "input_finish")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    # Strip LF and then CR, preserving EOF without a line terminator.
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "input_store")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 6, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 10))
    call assembler.relative(output, [15, 133], "input_check_cr")
    call assembler.emit(output, x86_64.decrement(0))
    call assembler.label(output, "input_check_cr")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "input_store")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 6, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 13))
    call assembler.relative(output, [15, 133], "input_store")
    call assembler.emit(output, x86_64.decrement(0))
    call assembler.label(output, "input_store")
    call assembler.emit(output, x86_64.store_memory(1, 8, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 0, 2))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_readfile(output):
    call assembler.label(output, "runtime_readfile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "readfile_opened")
    call assembler.relative(output, x86_64.lea_rip_prefix(13), "readfile_error_data")
    call assembler.emit(output, x86_64.mov_imm64(14, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readfile_opened")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    # Determine exact size with lseek(fd, 0, SEEK_END), then rewind.
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(1, 8, 0))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 0, 2))
    # close(fd)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readfile_error_data")
    message = "FileError: cannot open file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_write_all(output):
    # Loop write(2) until every byte is sent. rdi=fd, rsi=buf, rdx=count.
    # syscall preserves rdi/rsi/rdx; returns 0 on success, -1 on write error.
    call assembler.label(output, "runtime_write_all")
    call assembler.label(output, "write_all_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "write_all_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "write_all_error")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
    call assembler.relative(output, [233], "write_all_loop")
    call assembler.label(output, "write_all_error")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "write_all_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_writefile(output):
    call assembler.label(output, "runtime_writefile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 577))
    call assembler.emit(output, x86_64.mov_imm64(2, 493))
    call assembler.emit(output, x86_64.mov_imm64(0, 2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "writefile_opened")
    call assembler.relative(output, x86_64.lea_rip_prefix(13), "writefile_error_data")
    call assembler.emit(output, x86_64.mov_imm64(14, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writefile_opened")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.load_memory(2, 1, 8))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writefile_error_data")
    message = "FileError: cannot write file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_appendfile(output):
    call assembler.label(output, "runtime_appendfile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 1089))
    call assembler.emit(output, x86_64.mov_imm64(2, 493))
    call assembler.emit(output, x86_64.mov_imm64(0, 2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "appendfile_opened")
    call assembler.relative(output, x86_64.lea_rip_prefix(13), "appendfile_error_data")
    call assembler.emit(output, x86_64.mov_imm64(14, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "appendfile_opened")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.load_memory(2, 1, 8))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "appendfile_error_data")
    message = "FileError: cannot append file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_writebytes(output):
    call assembler.label(output, "runtime_writebytes")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 1))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(8, 6, 24))
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-56, 2))
    call assembler.label(output, "writebytes_copy")
    call assembler.emit(output, x86_64.load_stack(2, -56))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "writebytes_open")
    call assembler.emit(output, x86_64.load_stack(8, -48))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.emit(output, x86_64.load_stack(2, -56))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 2, 0))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-56, 2))
    call assembler.relative(output, [233], "writebytes_copy")
    call assembler.label(output, "writebytes_open")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 577))
    call assembler.emit(output, x86_64.mov_imm64(2, 493))
    call assembler.emit(output, x86_64.mov_imm64(0, 2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "writebytes_opened")
    call assembler.relative(output, x86_64.lea_rip_prefix(13), "writebytes_error_data")
    call assembler.emit(output, x86_64.mov_imm64(14, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writebytes_opened")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.mov_imm64(0, 3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writebytes_error_data")
    message = "FileError: cannot write file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_paths(output):
    call assembler.label(output, "runtime_mkdir")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 493))
    call assembler.emit(output, x86_64.mov_imm64(0, 83))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_unlink")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, 87))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
end

function emit_exists(output):
    call assembler.label(output, "runtime_exists")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 21))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.emit(output, x86_64.set_condition(148))
    call assembler.emit(output, x86_64.ret())
end

function emit_all(output):
    call emit_cstring(output)
    call emit_input(output)
    call emit_readfile(output)
    call emit_write_all(output)
    call emit_writefile(output)
    call emit_appendfile(output)
    call emit_writebytes(output)
    call emit_paths(output)
    call emit_exists(output)
end
